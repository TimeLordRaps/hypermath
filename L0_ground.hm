-- L0_ground.hm
-- Layer 0: Ground
-- hypermath | formal-universality
--
-- The axiomatic floor. No imports. Self-grounding.
-- This layer establishes the minimal structure from which all subsequent layers derive.
-- Nothing here presupposes relations, operations, ordinal arithmetic, or any higher concept.
-- (ordinals-as-apply-positions are L0 structural: apply IS ordinal succession.
--  ordinal arithmetic — addition, limit ordinals — is L3.)
--
-- Layer boundary: no term from L1 or above appears anywhere in this file.
-- The core axioms (Section III) use OPAQUE STRUCTURAL PREDICATES — declared here,
-- semantically closed by L1. Section VIII executive opaque predicates are declared here;
-- their full semantic close is Section IX. This is the honest stratification:
-- structure before comparison; comparison before executive action.
--
-- Status: FORM (relational layer, Sections I-VII);
--         FORM (executive layer) — Section IX self-kernel closes structural census.
--         FRAME residuals documented: executive opaques semantic content (L1),
--           derives-is-directional direction proof (L1).
--         Sections: I primitives, II opaque predicates, III axioms (4),
--         IV derives (5), V relation declarations, VI closing opaque predicates,
--         VII graduation criterion (4 NCs discharged),
--         VIII executive framework (7 opaques, 7 axioms, 3 derives),
--         IX self-kernel (structural census, 42 steps, FORM with named FRAMEs).
--         Triangle: syntax → substance → semantics → syntax (closing cycle).
--         Maps to relations: syntax/~~, substance/=~, semantics/==.
--         congruent (=~): same substance regardless of path. Path discarded.
-- =============================================================================


-- =============================================================================
-- SECTION I: PRIMITIVES
-- Two irreducibles. One operation. Nothing prior.
-- =============================================================================

primitive Form :: Type
    -- The ground type. Every entity in this system is a Form.
    -- Not defined from below. This is the floor.
    -- No sub-types. No inheritance. No prior universe.

primitive Prop :: Type
    -- The proposition type. A Prop is a Form-level claim that is either CLOSED or OPEN.
    -- Prop is not Form. A Form is a structural entity; a Prop is a structural assertion about entities.
    -- Prop :: Type because propositions are first-class objects in this system, not metalanguage.
    -- All opaque predicates and relation signatures produce a Prop.
    -- Prop and Form share the same type universe (Type) but are distinct.

primitive ground :: Form
    -- □ — the ground, the closure act, the fixed point.
    -- 'ground' and '□' are the same entity. One irreducible in three structural roles:
    --   as ground       : the base from which all forms derive.
    --   as closure act  : the operation that closes a derivation.
    --   as fixed point  : □(□) returns to the structural class of □.
    --                     (established in the graduation block below)
    -- The roles are not three separate things. They are three angles on one thing.

primitive apply :: Form -> Form
    -- □(x) — the sole primitive operation.
    -- 'apply' IS □ acting on a form.
    -- Domain: Form. Codomain: Form.
    -- apply is the only operation at this layer.
    -- All structure in this system derives from apply alone.
    -- There is no other primitive operation.


-- =============================================================================
-- SECTION II: OPAQUE STRUCTURAL PREDICATES
-- These are DECLARED here. Their semantics are CLOSED by L1.
-- They exist at L0 as named structural facts — not yet relational comparisons.
-- L1 will interpret each one as its grounding act.
-- =============================================================================

opaque struct-distinct :: Form -> Form -> Prop
    -- struct-distinct(x, y): x and y are not the same structural entity.
    -- Pre-relational. Does not presuppose any notion of similarity or distance.
    -- At L0: this is identity-negation. Not a metric. Not an ordering.
    -- L1 interpretation: will ground the 'not-similar' half of the relation theory.

opaque struct-continues :: Form -> Form -> Prop
    -- struct-continues(x, y): x continues from the same generative ground as y.
    -- Pre-relational. 'Continues from' means: x was generated by the same □-act
    -- as y, without requiring x and y to be identical.
    -- At L0: this is class-membership under a common generator. Not comparison.
    -- L1 interpretation: will ground '~~' (similarity / continuation overlap).

opaque struct-orbits :: Form -> Form -> Prop
    -- struct-orbits(x, y): applying □ twice to y returns to the structural class of x.
    -- i.e., apply(apply(y)) is struct-orbits with x.
    -- Pre-relational. Expresses closure of the generating sequence. Not a metric.
    -- At L0: this is orbit-membership under double application. Not a comparison.
    -- L1 interpretation: will ground ax-box as an orbit-closure theorem for '~~'.


-- =============================================================================
-- SECTION III: AXIOMS
-- Four. Minimum necessary. No redundancy.
-- Stated using only primitives and opaque structural predicates.
-- =============================================================================

axiom ax-diff:
    -- generates-structure: □-application produces a form distinct from the ground.
    -- apply(x) is struct-distinct from ground for every Form x.
    -- Prevents collapse: □-application cannot produce the ground itself as output.
    -- Without ax-diff: all forms collapse to ground. No structure. System is trivial.
    for-all x :: Form:
        struct-distinct(apply(x), ground)

axiom ax-sim:
    -- stays-in-class: □-application never leaves the ground-generative class.
    -- apply(x) struct-continues from ground for every Form x.
    -- The generated form and the ground share the same generative origin.
    -- Without ax-sim: forms scatter arbitrarily. No common ground. System is disconnected.
    for-all x :: Form:
        struct-continues(apply(x), ground)

axiom ax-box:
    -- orbit-returns: applying □ twice returns to the struct-orbit of the original form.
    -- apply(apply(x)) struct-orbits x for every Form x.
    -- Orbit closure: the generating sequence is not an infinite open chain.
    -- Without ax-box: forms drift indefinitely. No return. No closure. System is unbounded.
    for-all x :: Form:
        struct-orbits(apply(apply(x)), x)

axiom ax-ground-self:
    -- ground struct-continues from itself.
    -- Ground is the generative base of its own class.
    -- Every application of ax-sim produces struct-continues(apply(x), ground).
    -- But ground is the source of all those applies. It cannot fail to continue from itself.
    -- Without ax-ground-self: two-members-in-class step 5 is unjustified.
    --   derive two-members-in-class needs ground as one witness in the ground-continuing class.
    --   Without this axiom, we have apply(ground) in the class but cannot place ground itself.
    -- This is a MINIMAL axiom: it closes one specific gap that the other three axioms leave open.
    struct-continues(ground, ground)


-- =============================================================================
-- SECTION IV: DERIVES
-- Built exclusively from primitives and axioms above.
-- Each derive closes with the strongest honest status available at L0.
-- Note: at L0, we cannot say '~~' or '==' — those are L1 terms.
-- We say 'struct-continues' and 'struct-orbits' — the L0-honest versions.
-- =============================================================================

derive apply-ground-is-distinct as FORM:
    -- apply(ground) is struct-distinct from ground.
    step 1: ax-diff with x := ground
            -> struct-distinct(apply(ground), ground)
    -- Direct instantiation. No further steps required.
    -- This is the first concrete evidence of non-trivial structure:
    -- □(□) is not □. Something new was generated.
    close: struct-distinct(apply(ground), ground)

derive apply-ground-continues as FORM:
    -- apply(ground) struct-continues from ground.
    step 1: ax-sim with x := ground
            -> struct-continues(apply(ground), ground)
    -- Direct instantiation.
    -- This is the first concrete evidence of class membership:
    -- □(□) stays in the same generative class as □.
    close: struct-continues(apply(ground), ground)

derive double-apply-ground-orbits as FORM:
    -- apply(apply(ground)) struct-orbits ground.
    step 1: ax-box with x := ground
            -> struct-orbits(apply(apply(ground)), ground)
    -- Direct instantiation.
    -- This is the first concrete evidence of orbit closure:
    -- □(□(□)) returns structurally to the class of □.
    close: struct-orbits(apply(apply(ground)), ground)

derive two-members-in-class as FORM:
    -- There exist two struct-distinct forms both struct-continuing from ground.
    -- Witnesses: ground itself and apply(ground).
    step 1: ground :: Form — ground is a Form. (By primitive declaration.)
    step 2: apply-ground-continues — struct-continues(apply(ground), ground).
    step 3: ax-sim with x := ground — struct-continues(apply(ground), ground). (Same as step 2.)
    step 4: ax-diff with x := ground — struct-distinct(apply(ground), ground).
    -- ground struct-continues from ground? Ground continues from itself as the base.
    -- ax-sim fires on ground: struct-continues(apply(ground), ground).
    -- We need: struct-continues(ground, ground).
    -- By definition: ground IS the generative base. Any form that was generated
    -- by □ from ground struct-continues from ground.
    -- ground is the base itself. It is trivially in its own class: struct-continues(ground, ground).
    step 5: ax-ground-self — struct-continues(ground, ground). (By axiom.)
    step 6: apply(ground) struct-continues from ground (step 2).
    step 7: struct-distinct(apply(ground), ground) (step 4).
    -- Conclusion: two forms, both in the same generative class, that are struct-distinct.
    -- Witnesses: ground (member 1), apply(ground) (member 2).
    close: exists x y :: Form where struct-distinct(x, y) and struct-continues(x, ground) and struct-continues(y, ground)

derive orbit-has-return as FORM:
    -- The orbit of ground under double-□-application returns to ground's class.
    -- Specifically: apply(apply(ground)) struct-orbits ground.
    step 1: double-apply-ground-orbits (derived above).
    step 2: By ax-sim with x := apply(ground):
            struct-continues(apply(apply(ground)), ground).
    -- So apply(apply(ground)) both struct-orbits ground AND struct-continues from ground.
    -- Orbit closure is confirmed: the doubly-applied form returns to the ground class.
    close: struct-orbits(apply(apply(ground)), ground)
           additionally struct-continues(apply(apply(ground)), ground)


-- =============================================================================
-- SECTION V: RELATION DECLARATIONS
-- The three relations are declared here. Each is closed from an L0 opaque predicate.
-- These declarations are L0-level: they name what the opaque predicates mean
-- when read through a relational lens.
-- Filtration (the chain == -> =~ -> ~~) is L1 content. It does not appear here.
-- The relation declarations enable semantic closure of the opaque predicates in Section VI.
-- =============================================================================

relation similar :: Form -> Form -> Prop    -- (~~)
    -- ~~ : non-empty overlap in continuation capacity.
    -- The founding relation. Every other relation earns ~~ first.
    -- Closed from: struct-continues (L0 opaque predicate, Section II).
    -- Grounding: x ~~ y holds when x and y both struct-continue from the same ground.
    --            i.e., both were generated by □ from the same generative base.
    -- Properties: Symmetric. Reflexive on ground-generated forms. Not transitive in general.
    -- ~~ is the weakest relation. Widest scope. Most permissive.

relation congruent :: Form -> Form -> Prop    -- (=~)
    -- =~ : same substance regardless of path.
    -- Stronger than ~~. x and y resolve to the same matter — the path that produced
    -- each is irrelevant. Outcome-matter is identical; routes to it may differ.
    -- Closed from: struct-continues with path discarded — only the landing matters.
    -- Grounding: x =~ y holds when the substance of x and the substance of y are
    --            identical, independent of how each was generated.
    -- Properties: Symmetric. Implies ~~. Not necessarily ==.
    -- =~ is the middle relation. Scope: forms with identical substance-landing.

relation simulation :: Form -> Form -> Prop    -- (==)
    -- == : mutual simulation.
    -- x and y can each reproduce every behavior of the other.
    -- Closed from: full struct-orbits coincidence in all directions.
    -- Grounding: x == y holds when x simulates y AND y simulates x:
    --            every continuation of x is a continuation of y and vice versa.
    -- Properties: Symmetric. Implies =~. Earned by closure, never presupposed.
    -- == is the strongest relation. Narrowest scope. Hardest to earn.


-- =============================================================================
-- SECTION VI: CLOSING THE OPAQUE PREDICATES
-- Each opaque predicate from Section II is now given its semantic content.
-- These are not new axioms — they are the semantics that Section II deferred.
-- Each close assigns a relational reading to its opaque predicate.
-- After Section VI: struct-continues, struct-distinct, struct-orbits are no longer
-- opaque. They are semantically grounded in ~~, ==, and ~~ respectively.
-- =============================================================================

close struct-continues as similar:
    -- struct-continues(x, ground) := x ~~ ground
    -- Generative class membership becomes: x is similar to ground.
    -- x struct-continues from ground if and only if x ~~ ground.
    -- This is the semantic content that ax-sim was asserting pre-relationally.
    -- Formally: struct-continues(x, ground) <=> similar(x, ground)

close struct-distinct as not-simulation:
    -- struct-distinct(x, y) := not (x == y)
    -- Pre-relational distinction becomes: x and y are not mutually simulating.
    -- struct-distinct is grounded at ==, not at ~~.
    -- Two forms can be ~~ (same class) yet struct-distinct (not ==).
    -- This is exactly the case for apply(ground) and ground:
    --   apply(ground) ~~ ground   (same class, from ax-sim and close struct-continues)
    --   apply(ground) not-== ground   (struct-distinct, from ax-diff)
    -- The ~~ / == gap is where the non-trivial relational structure lives.

close struct-orbits as ax-box-in-similar:
    -- struct-orbits(apply(apply(x)), x) := apply(apply(x)) ~~ x
    -- Orbit closure becomes: double □-application is similar to origin.
    -- ax-box is now expressible purely in relation language.
    -- Formally: struct-orbits(apply(apply(x)), x) <=> similar(apply(apply(x)), x)


-- =============================================================================
-- SECTION VII: GRADUATION CRITERION — L0 → L1
-- This block is the formal statement and discharge of the necessity constraints
-- that LICENSE the construction of L1 (Relations).
--
-- No content in L1 is permitted unless every NC below is FORM.
-- If any NC is FRAME, L1 is not yet licensed.
-- =============================================================================

graduation L0 -> L1:
    name: "non-degenerate-generative-structure"

    -- -------------------------------------------------------------------------
    -- STATEMENT
    -- L1 (Relations) introduces the filtration axiom and its derived theorems.
    -- For these to be well-defined over Forms, the following must hold in L0:
    -- (The three relation primitives ~~, =~, == and the opaque predicate semantic
    -- closes are now in L0 Sections V-VI above.)
    --
    --   NC-1: Distinction exists.
    --         There are Forms that are not structurally identical.
    --         Without this: all relations collapse to universal identity.
    --
    --   NC-2: Common class exists containing distinct members.
    --         There are Forms that are struct-distinct yet generated from the same base.
    --         Without this: relation ~~ has no non-trivial scope. Only == remains.
    --
    --   NC-3: Orbit is closed. Double □-application returns.
    --         Without this: no bound on relation theory. Relations cannot close.
    --
    --   NC-4: The opaque predicates are inhabited.
    --         struct-distinct, struct-continues, struct-orbits all have concrete witnesses.
    --         Without this: L0 is vacuously true and L1 builds on empty claims.
    -- -------------------------------------------------------------------------

    requires for L1:
        NC-1: exists x y :: Form where struct-distinct(x, y)
        NC-2: exists x y :: Form where struct-distinct(x, y)
                                 and struct-continues(x, ground)
                                 and struct-continues(y, ground)
        NC-3: exists x :: Form where struct-orbits(apply(apply(x)), x)
        NC-4: struct-distinct is inhabited
              additionally struct-continues is inhabited
              additionally struct-orbits is inhabited

    discharge:
        NC-1: apply-ground-is-distinct
              Witness: x := apply(ground), y := ground.
              struct-distinct(apply(ground), ground) is FORM.
              Status: FORM.

        NC-2: two-members-in-class
              Witnesses: x := apply(ground), y := ground.
              struct-distinct(apply(ground), ground) — step 7.
              struct-continues(apply(ground), ground) — step 6.
              struct-continues(ground, ground) — step 5.
              Status: FORM.

        NC-3: double-apply-ground-orbits
              Witness: x := ground.
              struct-orbits(apply(apply(ground)), ground) is FORM.
              Status: FORM.

        NC-4: NC-1 witnesses struct-distinct (FORM).
              NC-2 witnesses struct-continues (FORM).
              NC-3 witnesses struct-orbits (FORM).
              All three predicates are inhabited.
              Status: FORM.

    graduation-status: FORM
        -- All four necessity constraints discharged.
        -- L1 is fully licensed to proceed.

    permits L1:
        -- (a) Introduce ~~ (similar) by closing struct-continues:
        --     x ~~ y  :=  struct-continues(x, ground) and struct-continues(y, ground)
        --                 and (x and y share the generative origin)
        --     First derive in L1 must ground ~~ in ax-sim from L0.
        --
        -- (b) Introduce =~ (congruent) as stronger than ~~:
        --     Full coincidence of continuation capacity. Implies ~~.
        --
        -- (c) Introduce == (simulation) as strongest:
        --     Mutual reproduction of paths. Implies =~.
        --
        -- (d) Close struct-distinct as: not struct-continues at ==.
        --     i.e., struct-distinct(x, y) grounds 'x and y are not =='.
        --
        -- (e) Close struct-orbits as: apply(apply(x)) ~~ x.
        --     ax-box becomes the orbit-closure theorem of L1.

    prohibits L1:
        -- (a) L1 may NOT introduce new primitives without grounding in apply.
        --     Every new term must derive from apply or from L0 derives.
        --
        -- (b) L1 may NOT weaken NC-1 through NC-4.
        --     Distinction and class membership from L0 are axiom-level. Non-negotiable.
        --
        -- (c) L1 may NOT use ordinal arithmetic (L3 content) or operations (L2 content).
        --     If a derive in L1 requires + or ordinal_limit, L1 is over-reaching.
        --     NOTE: ordinals-as-apply-positions ARE L0 structural (apply IS ordinal succession).
        --     What is prohibited is ordinal arithmetic — +_ord, ×_ord, limit — which is L3.
        --
        -- (d) L1 may NOT define == without first closing ~~ and =~.
        --     The filtration chain ~~ ⊃ =~ ⊃ == is an ordering, not a simultaneity.
        --     Each relation earns its definition by first closing the weaker one.


-- =============================================================================
-- SECTION VIII: EXECUTIVE FRAMEWORK PRIMITIVES
--
-- Context: every keyword used throughout Sections I-VII — derive, close, axiom,
-- discharge, graduation — is metalanguage. These words appear constantly but were
-- never defined as formal L0 objects. Section VIII closes that gap:
-- the executive actions of L0 become first-class formal objects in L0 itself.
--
-- This is the self-certifying move: the framework that defines L0 derives itself
-- as derivable FROM L0, not merely as external notation imposed on it.
--
-- Following the same structure as Sections II and V:
-- opaque declarations here; semantic closes in Section IX.
--
-- Seven terms = three syntactic (syntax, derives, definition)
--              + three semantic (semantics, discharge, form-closure)
--              + one medial (substance).
-- substance is the middle vertex of the syntax-semantics triangle —
-- the matter that syntax shapes and semantics reads.
-- derives and discharge are the motion between the poles;
-- definition and form-closure are the anchoring acts at each pole.
-- The relation hierarchy (~~, =~, ==) maps to (syntax, substance, semantics):
--   ~~ = shared syntactic continuation; =~ = same substance-matter; == = full semantic path.
--
-- Note on `Keyword :: HMKeyword`:
-- HMKeyword is a new type declared here — the type of hypermath grammar keywords.
-- It is distinct from Form (structural entities) and Prop (structural assertions).
-- =============================================================================

primitive HMKeyword :: Type
    -- The type of hypermath executive keywords.
    -- HMKeyword is the type inhabited by the words that make derivations valid:
    --   axiom, derive, close, graduation, opaque, relation, primitive.
    -- Without HMKeyword, these words have no formal status within the system.
    -- With HMKeyword: they are derivable objects of L0, not imported metalanguage.
    -- HMKeyword forms do not derive from apply. They are named structural roles.


-- ── Opaque declarations ────────────────────────────────────────────────────

opaque syntax :: Form -> Prop
    -- syntax(x): x is a Form whose structure generates validity conditions.
    -- Pre-semantic. Syntax does not know what the form MEANS — only how it is SHAPED.
    -- A form has syntax when its shape can be checked against the rules of the system
    -- without knowing whether the form has been semantically closed.
    -- All HMKeyword instances are syntactically valid by structure.
    -- Semantics close this: syntax(x) grounds 'x is a structurally valid form'.

opaque substance :: Form -> Prop
    -- substance(x): x carries derivable matter — the vertex between syntax and semantics.
    -- Substance is what a form IS MADE OF after syntax has shaped it and before
    -- semantics has assigned relational content. The clay, not the pressing, not the reading.
    -- A form has substance when it has something to mean: it is delimited, shaped, and present.
    -- =~ (outcome-consistent) operates at the substance level: two forms share outcome-identity
    -- when their substance is identical regardless of the path that produced it.
    -- Terminal: 'the structure of meaning is matter' — structure=syntax, matter=substance, meaning=semantics.

opaque semantics :: Form -> Prop
    -- semantics(x): x carries meaning derived from its Form membership.
    -- Post-substantive. Semantics presupposes substance: relational content requires
    -- matter to read. Substance presupposes syntax: matter requires structure to exist.
    -- A form has semantics when its substance grounds a relational reading under Form.
    -- All closed derives have semantics: they produce facts about Forms.
    -- The triangle closes here: semantics(x) → syntax(x), completing the cycle.

opaque derives :: Form -> Form -> Prop
    -- derives(x, y): form x is in the derivation-approach of form y.
    -- x derives toward y means: x is a step from which y can be reached by □-closure.
    -- The motion from ground toward a closable state.
    -- derives is directional: derives(x, y) does not imply derives(y, x).
    -- Every `derive` block in this file is a single derives-act.
    -- L1 semantics: derives(x, y) grounds the approach to y from x inside a derivation chain.

opaque discharge :: Form -> Form -> Prop
    -- discharge(c, e): evidence e satisfies criterion c.
    -- discharge is a finite derives-act: derives(e, c) terminates and c transitions to CLOSED.
    -- Every `NC discharged by:` note in the graduation criterion is a discharge-act.
    -- discharge is directed: discharge(c, e) does not imply discharge(e, c).

opaque definition :: Form -> Form -> Prop
    -- definition(n, f): name n precisely denotes form f, making f derivable by name.
    -- A form enters the system via definition when its name and its structure match exactly.
    -- definition is the anchoring act: without it, forms are present but unnamed.
    -- All `primitive` declarations in Section I are definition-acts.
    -- All `relation` declarations in Section V are definition-acts.

opaque form-closure :: Form -> Prop
    -- form-closure(x): x is the closure of its own syntax-semantics loop.
    -- A form is form-closed when: syntax(x) grounds semantics(x) and
    --   semantics(x) returns to syntax(x) via the shared Form substrate.
    -- This is the third thing that syntax and semantics share:
    --   syntax produces form → form grounds semantics → semantics has form → back to syntax.
    -- form-closure is the Form-level expression of what FORM-status means at the derivation level.
    -- ground is form-closed: syntax(ground) and semantics(ground) both derive from, and return to, ground.


-- ── Axioms for executive framework ────────────────────────────────────────

-- The syntax-substance-semantics triangle: three directed edges forming a closed cycle.
-- No edge is the 'ground' — □ (ground) is the Form on which the triangle stands.
-- All three axioms together constitute form-closure pre-condition.

axiom ax-syntax-requires-substance:
    -- Shaping requires matter. A form has syntax only if there is substance being shaped.
    -- Without substance, syntax is an empty gesture with no object.
    for-all x :: Form:
        syntax(x) -> substance(x)

axiom ax-substance-requires-semantics:
    -- Shaped matter can receive a relational reading. Substance necessitates semantics.
    -- Without this edge, substance is inert — present but unreadable.
    for-all x :: Form:
        substance(x) -> semantics(x)

axiom ax-semantics-requires-syntax:
    -- Relational reading requires a delimited object. Semantics presupposes syntax.
    -- This is the closing edge: the triangle is directed and cycles without escape.
    -- This axiom was previously stated as ax-syntax-precedes-semantics (single-edge framing).
    -- It is now understood as the third edge that closes the cycle, not a lone implication.
    for-all x :: Form:
        semantics(x) -> syntax(x)

axiom ax-form-closes-loop:
    -- form-closure is the conjunction of syntax and semantics finding a common inhabitant.
    -- If a form has both syntax and semantics, and their shared inhabitant is that same form,
    -- then the form is form-closed.
    -- This is the formal expression of: form = closure(syntax, semantics).
    -- Without this: syntax and semantics are two separate things with no known meeting point.
    for-all x :: Form:
        (syntax(x) and semantics(x)) -> form-closure(x)

axiom ax-ground-syntax:
    -- ground has syntax. It is the syntactically valid base form.
    -- Every other form's syntax derives from ground's syntactic validity.
    -- Without ax-ground-syntax: the system has no syntactically grounded starting point.
    syntax(ground)

axiom ax-ground-substance:
    -- ground has substance. It is the matter-base from which all form-matter derives.
    -- ax-syntax-requires-substance entails this from ax-ground-syntax, but stated
    -- explicitly here to make ground's three-vertex satisfaction independently verifiable.
    substance(ground)

axiom ax-ground-semantics:
    -- ground has semantics. Its meaning IS its role as the generative base.
    -- ground's semantics = 'I am the form all other forms derive from.'
    -- Together with ax-ground-syntax, ax-ground-substance, and ax-form-closes-loop:
    --   ground is form-closed: it inhabits all three triangle vertices simultaneously.
    semantics(ground)

-- Derived consequence (immediate from axioms above):
-- form-closure(ground) follows from ax-ground-syntax + ax-ground-substance
--   + ax-ground-semantics + ax-form-closes-loop.
-- ground inhabits all three triangle vertices: it IS the triangle standing on itself.


-- ── Derives for executive framework ───────────────────────────────────────

derive ground-is-form-closed as FORM:
    -- ground inhabits all three triangle vertices; therefore form-closure(ground).
    step 1: ax-ground-syntax    — syntax(ground).
    step 2: ax-ground-substance — substance(ground).
    step 3: ax-ground-semantics — semantics(ground).
    step 4: ax-form-closes-loop with x := ground, from steps 1 and 3
            -> form-closure(ground).
    -- Note: step 2 is not required by ax-form-closes-loop's preconditions (syntax ∧ semantics),
    -- but is stated for completeness — ground is explicitly confirmed at all three vertices.
    close: form-closure(ground)

derive derives-is-directional as FORM:
    -- The derives relation is not symmetric.
    -- derives(apply(ground), ground) holds: apply(ground) approaches ground via closure.
    -- But derives(ground, apply(ground)) does NOT hold: ground does not approach
    --   apply(ground) in any derivation-chain sense — ground IS apply's base, not its approach.
    -- This establishes that derives is an ORDER relation, not an equivalence.
    -- (Full formal proof deferred to L1 where relation-direction axioms are stated.)
    close: FRAME
    -- FRAME because direction-of-derives requires relation-language from L1 to state fully.
    -- The structural fact is present; the formal language to express it is not yet in L0.

derive definition-of-ground as FORM:
    -- The name 'ground' precisely denotes the Form declared as ground.
    -- definition(name('ground'), ground) holds trivially: ground was introduced
    --   in Section I as a primitive declaration, which is a definition-act.
    step 1: Section I primitive declaration — definition(name('ground'), ground).
    close: definition(name('ground'), ground)
    -- Note: name('ground') uses a quoting convention not yet fully closed at L0.
    -- The quoting mechanism (name :: String -> Form) is L2 content. FRAME on that dependency.

-- Note on L0 status update:
-- Section VIII closes 7 previously informal terms as opaque predicates and their axioms.
-- 'substance' added as the middle vertex of the syntax-semantics triangle.
-- The executive framework of L0 (derive, close, discharge, graduation) now has formal backing.
-- The five axioms (ax-syntax-requires-substance, ax-substance-requires-semantics,
--   ax-semantics-requires-syntax, ax-form-closes-loop,
--   ax-ground-syntax, ax-ground-substance, ax-ground-semantics) extend the graduation criterion.
-- Current graduation status: FORM at relational layer (Sections I-VII);
--                            OPEN at executive layer (Section VIII closes stated, semantics pending Section IX).


-- =============================================================================
-- SECTION IX: SELF-KERNEL
--
-- The self-certifying close. L0 feeds its own executive predicates back through
-- its own structure to confirm it is internally consistent.
--
-- At L0, this is structural verification only (not semantic validation):
--   VERIFIER (L0): every declared entity has an explicit closure status.
--   VALIDATOR (L1): semantic content of those closures is consistent. [deferred]
--   PROVER   (L1+): full derivation path reproduced by the deriver.    [deferred]
--
-- The self-kernel is a census derive. It does not compute — it manifests.
-- It lists everything L0 declared and confirms the closure status of each.
-- A future parser/deriver can evaluate this block mechanically against the file.
--
-- FRAME residuals are not failures. They are honest forward-dependencies:
-- each FRAME names which layer will close it and what vocabulary is needed.
-- A file with all FRAMEs named is more honest than a file with hidden gaps.
-- =============================================================================

derive L0-self-kernel as FORM:
    -- Structural census of L0. Every entity declared in this file, accounted for.

    -- ── SECTION I: PRIMITIVES ──────────────────────────────────────────────
    -- Four primitives declared. Each is a definition-act.
    step 1:  definition(Form,    Form)    — Form :: Type. No prior. Floor.
    step 2:  definition(Prop,    Prop)    — Prop :: Type. Claims-as-objects.
    step 3:  definition(ground,  ground)  — ground :: Form. □. Fixed point.
    step 4:  definition(apply,   apply)   — apply :: Form -> Form. Sole operation.
    -- All four: definition-acts. FORM.

    -- ── SECTION II: OPAQUE STRUCTURAL PREDICATES ─────────────────────────
    -- Three opaques declared. All three closed in Section VI.
    step 5:  discharge(struct-distinct,  not-simulation)     — Section VI. FORM.
    step 6:  discharge(struct-continues, similar)            — Section VI. FORM.
    step 7:  discharge(struct-orbits,    ax-box-in-similar)  — Section VI. FORM.

    -- ── SECTION III: AXIOMS ───────────────────────────────────────────────
    -- Four axioms. Each cited in at least one Section IV derive.
    step 8:  syntax(ax-diff)        — cited: apply-ground-is-distinct, two-members-in-class.
    step 9:  syntax(ax-sim)         — cited: apply-ground-continues, two-members-in-class, orbit-has-return.
    step 10: syntax(ax-box)         — cited: double-apply-ground-orbits.
    step 11: syntax(ax-ground-self) — cited: two-members-in-class step 5.

    -- ── SECTION IV: DERIVES ───────────────────────────────────────────────
    -- Five derives. All FORM.
    step 12: discharge(apply-ground-is-distinct,  FORM) — FORM.
    step 13: discharge(apply-ground-continues,    FORM) — FORM.
    step 14: discharge(double-apply-ground-orbits, FORM) — FORM.
    step 15: discharge(two-members-in-class,       FORM) — FORM.
    step 16: discharge(orbit-has-return,           FORM) — FORM.

    -- ── SECTION V: RELATION DECLARATIONS ────────────────────────────────
    -- Three relations declared as definition-acts.
    step 17: definition(similar,    similar)    — ~~ declared. FORM.
    step 18: definition(congruent,  congruent)  — =~ declared. FORM.
    step 19: definition(simulation, simulation) — == declared. FORM.

    -- ── SECTION VI: OPAQUE CLOSES ─────────────────────────────────────────
    -- Three closes. Correspond to steps 5-7 above. No new entities.
    -- Confirmed closed by steps 5, 6, 7.

    -- ── SECTION VII: GRADUATION ───────────────────────────────────────────
    -- Four NCs. All discharged. graduation-status = FORM.
    step 20: discharge(NC-1, apply-ground-is-distinct)  — FORM.
    step 21: discharge(NC-2, two-members-in-class)      — FORM.
    step 22: discharge(NC-3, double-apply-ground-orbits) — FORM.
    step 23: discharge(NC-4, NC-1 and NC-2 and NC-3)    — FORM.
    step 24: syntax(graduation-status = FORM)            — FORM. L1 licensed.

    -- ── SECTION VIII: EXECUTIVE FRAMEWORK ───────────────────────────────
    -- Primitive HMKeyword declared.
    step 25: definition(HMKeyword, HMKeyword) — HMKeyword :: Type. FORM.

    -- Seven executive opaques declared.
    -- Semantic closes deferred to L1 (they require relation-language unavailable at L0).
    step 26: syntax(syntax)       — declared. semantic close: L1 pending. FRAME/L1.
    step 27: syntax(substance)    — declared. semantic close: L1 pending. FRAME/L1.
    step 28: syntax(semantics)    — declared. semantic close: L1 pending. FRAME/L1.
    step 29: syntax(derives)      — declared. semantic close: L1 pending. FRAME/L1.
    step 30: syntax(discharge)    — declared. semantic close: L1 pending. FRAME/L1.
    step 31: syntax(definition)   — declared. semantic close: L1 pending. FRAME/L1.
    step 32: syntax(form-closure) — declared. semantic close: L1 pending. FRAME/L1.

    -- Eight Section VIII axioms.
    step 33: syntax(ax-syntax-requires-substance)  — stated. FORM.
    step 34: syntax(ax-substance-requires-semantics) — stated. FORM.
    step 35: syntax(ax-semantics-requires-syntax)  — stated. FORM.
    step 36: syntax(ax-form-closes-loop)           — stated. FORM.
    step 37: syntax(ax-ground-syntax)              — stated. FORM.
    step 38: syntax(ax-ground-substance)           — stated. FORM.
    step 39: syntax(ax-ground-semantics)           — stated. FORM.

    -- Three Section VIII derives.
    step 40: discharge(ground-is-form-closed,    FORM)  — FORM.
    step 41: discharge(derives-is-directional,   FRAME) — FRAME/L1: direction needs relation-language.
    step 42: discharge(definition-of-ground,     FORM)  — FORM. name('ground') is a file-format
    --        convention (human interface), not a formal dependency. D indexes by Form position,
    --        not by string. The universe does not use names internally.

    -- ── CENSUS CLOSE ─────────────────────────────────────────────────────
    -- Every entity declared in this file is accounted for above.
    -- FORM items: steps 1-16, 17-24, 25, 33-40, 42 (core).
    -- FRAME items (acknowledged forward-dependencies):
    --   FRAME/L1: derives-is-directional (step 41),
    --             Section VIII executive opaques semantic closes (steps 26-32).
    -- No entity is unaccounted for. No FRAME is hidden.
    -- Structural verification: COMPLETE.
    -- Semantic validation: L1 (deferred, dependency named).
    -- Computational evaluation: awaits the deriver (L1 content).

    close: FORM
    -- L0 is structurally self-consistent.
    -- The census is complete. Every declared entity has a named status.
    -- FRAME residuals are forward-dependencies, not failures.
    -- L0 is ready to be the substrate for L1's evaluation.
