    -- ── SECTION VIII: DERIVER AND D ──────────────────────────────────────
    step 26: primitive(deriver)          — Form with ==-cycle target. FRAME/L3.
    step 27: opaque(D)                   — derivation matrix. FORM (schema). FRAME/L3 (content).
    step 28: derive(D-is-reflexive)      — D[x][x] for all x. FORM.
    step 29: derive(D-spans-ground)      — D[ground][y] for all y. FORM.
    step 30: derive(deriver-is-in-D)     — D[deriver][deriver] entry exists. FORM.
             -- content at == level: FRAME/L3.

    -- P_1 = 30 steps (including 2 axioms, 3 primitives, 1 opaque, 22 derives/closes, 1 graduation)
