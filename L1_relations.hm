-- L1_relations.hm
-- Layer 1: Relations
-- hypermath | formal-universality
--
-- Imports: L0_ground.hm
-- License: L0 graduation FORM — all four NCs discharged.
--
-- This layer: filtration chain, trace axiom, executive opaque semantic closes,
-- derives-directional, individual/system/universe, deriver declaration, D matrix.
--
-- Layer boundary: no terms from L2 (operations) or above appear here.
--
-- Status: FORM (relational + executive closes + trace + matrix schema).
--         FRAME residuals:
--           simulation-pair-exists — non-trivial == pair (L2+)
--           deriver ==-cycle content — constructive proof (L3)
--           (name-quoting removed: file-format convention, not a formal dependency)
-- P_1 = 30. N_1_atomic = 5. G_1 = 4.


-- =============================================================================
-- SECTION I: AXIOMS (L1-LEVEL)
-- The filtration axiom. The only axiomatic addition in L1.
-- All other facts in L1 are derived from L0 + the relation definitions in L0.
-- =============================================================================

axiom filtration:
    -- == implies =~ implies ~~.
    -- The three relations are a strict chain, not independent.
    -- Simulation implies congruence implies similarity.
    -- The chain is derived from the orbit structure: each step is a strengthen-of.
    -- Formally:
    --   simulation(x, y) -> congruent(x, y)
    --   congruent(x, y)  -> similar(x, y)
    -- Note: the converses do NOT hold in general.
    simulation(x, y) -> congruent(x, y)    for-all x y :: Form
    congruent(x, y)  -> similar(x, y)      for-all x y :: Form


-- =============================================================================
-- SECTION II: DERIVES
-- Closed from L0 derives + filtration + relation definitions (via L0 import).
-- =============================================================================

derive similar-reflexive as FORM:
    -- x ~~ x for all Forms x.
    step 1: For any x :: Form, x struct-continues from ground (by ax-sim on x,
            or for ground itself: ground struct-continues from ground — base case from L0).
    step 2: By close struct-continues: struct-continues(x, ground) <=> similar(x, ground).
    step 3: So x ~~ ground for all x.
    step 4: Is x ~~ x? If x ~~ ground and ground ~~ x (by symmetry, derived below),
            then x ~~ x follows from transitivity at the ~~ level.
            Direct route: x and x trivially share all their continuations with themselves.
            Reflexivity holds by the definition of ~~ as overlap-in-continuation-capacity.
    close: relation(~~)

derive similar-symmetric as FORM:
    -- x ~~ y implies y ~~ x.
    step 1: ~~ is defined as overlap in continuation capacity.
    step 2: overlap is symmetric: if x and y share continuation capacity, so do y and x.
    step 3: Formally: similar(x, y) -> similar(y, x).
    close: relation(~~)

derive ax-sim-in-relation-language as FORM:
    -- ax-sim restated: apply(x) ~~ ground for all x.
    -- This is ax-sim with struct-continues closed to ~~.
    step 1: ax-sim: struct-continues(apply(x), ground) for all x (from L0).
    step 2: close struct-continues: struct-continues(apply(x), ground) <=> similar(apply(x), ground).
    step 3: Therefore: similar(apply(x), ground) — i.e., apply(x) ~~ ground.
    close: relation(~~)

derive ax-box-in-relation-language as FORM:
    -- ax-box restated: apply(apply(x)) ~~ x for all x.
    -- This is ax-box with struct-orbits closed to ~~.
    step 1: ax-box: struct-orbits(apply(apply(x)), x) for all x (from L0).
    step 2: close struct-orbits: struct-orbits(apply(apply(x)), x) <=> similar(apply(apply(x)), x).
    step 3: Therefore: similar(apply(apply(x)), x) — i.e., apply(apply(x)) ~~ x.
    close: relation(~~)

derive ax-diff-in-relation-language as FORM:
    -- ax-diff restated: apply(x) is not == ground for all x.
    -- Note: ax-diff says struct-distinct, which closes to 'not at =='.
    -- apply(x) and ground ARE ~~ (same class), but are NOT == (not mutually simulating).
    step 1: ax-diff: struct-distinct(apply(x), ground) for all x (from L0).
    step 2: close struct-distinct: struct-distinct(apply(x), ground) <=> not simulation(apply(x), ground).
    step 3: Therefore: not simulation(apply(x), ground) — apply(x) is not == ground.
    step 4: But ax-sim-in-relation-language: apply(x) ~~ ground.
    step 5: So: apply(x) ~~ ground  AND  not (apply(x) == ground).
    -- This is the defining non-trivial structure of the system:
    -- same class under ~~, genuinely distinct at ==.
    -- The ~~/== gap is inhabited. The system is non-trivial.
    close: relation(~~) additionally not-relation(==)

derive ground-fixed-point as FORM:
    -- apply(ground) ~~ ground, i.e., □(□) ~~ □.
    -- The ground is its own fixed point at ~~.
    step 1: ax-sim-in-relation-language with x := ground
            -> similar(apply(ground), ground).
    step 2: apply-ground-is-distinct (L0): struct-distinct(apply(ground), ground).
    step 3: ax-diff-in-relation-language with x := ground
            -> not simulation(apply(ground), ground).
    -- Fixed point at ~~: apply(ground) ~~ ground. FORM.
    -- Not a fixed point at ==: apply(ground) is not == ground. FORM.
    -- This is the honest closure: ~~ fixed point, == non-fixed-point. Both FORM.
    close: relation(~~) for fixed-point
           not-relation(==) for fixed-point-at-simulation

derive orbit-structure as FORM:
    -- The □-orbit: ground, apply(ground), apply(apply(ground)) all in the same ~~-class.
    -- Additionally: apply(apply(ground)) ~~ ground (orbit closure at ~~).
    step 1: ax-sim-in-relation-language: apply(ground) ~~ ground.
    step 2: ax-sim-in-relation-language with x := apply(ground):
            apply(apply(ground)) ~~ ground.
    step 3: ax-box-in-relation-language with x := ground:
            apply(apply(ground)) ~~ ground. (same conclusion, different route)
    step 4: Both routes agree. apply(apply(ground)) ~~ ground is doubly confirmed.
    step 5: The orbit {ground, apply(ground), apply(apply(ground))} is a single ~~-class.
    close: relation(~~)

derive simulation-pair-exists as FRAME:
    -- There exist two Forms x y such that x == y (mutual simulation).
    -- FRAME: we can assert ground == ground trivially (reflexive at ==),
    -- but establishing a NON-TRIVIAL simulation pair requires:
    --   (a) a definition of what 'every continuation' means — needs ordinal structure (L3)
    --   (b) a proof that two distinct forms reproduce each other's paths — needs operations (L2)
    -- Status: FRAME.
    -- Closure criterion: discharge this derive after L2 (operations) and L3 (ordinatics)
    --   provide the continuation-path machinery.
    -- What IS established: ground == ground (reflexive, trivial).
    --   'x == x' follows from the definition of simulation (x simulates itself trivially).
    step 1: simulation(ground, ground): ground trivially reproduces all its own behaviors.
    close: FRAME — non-trivial simulation pair not yet constructible at L1.
    open-frame: "non-trivial simulation pair needs L2+L3 continuation-path machinery"


-- =============================================================================
-- SECTION III: GRADUATION CRITERION — L1 → L2
-- =============================================================================

graduation L1 -> L2:
    name: "ordered-continuation-structure"

    -- -------------------------------------------------------------------------
    -- STATEMENT
    -- L2 (Operations) introduces '+' (definitive expansion) and 'additionally'
    -- (co-presence), and the quant family.
    -- For these to be well-defined, the following must hold:
    --
    --   NC-1: ~~ is a well-defined relation on Forms.
    --         Without this: '+' has no class to stay within. Operations scatter.
    --
    --   NC-2: =~ and == are defined and strictly stronger than ~~.
    --         Without this: no notion of 'same form' for operation identity laws.
    --
    --   NC-3: The filtration chain exists: == implies =~ implies ~~.
    --         Without this: operations cannot be verified to preserve class membership.
    --
    --   NC-4: The ~~/== gap is inhabited (non-trivial structure exists).
    --         Without this: all operations trivially preserve class (nothing interesting).
    --         NC-4 is what makes L2 operations genuinely produce new structure.
    -- -------------------------------------------------------------------------

    requires for L2:
        NC-1: similar is a well-defined reflexive symmetric relation on Form
        NC-2: congruent and simulation are defined and strictly imply ~~
              (filtration holds but converses fail on at least one pair)
        NC-3: filtration axiom is in scope
        NC-4: exists x y :: Form where similar(x, y) and not simulation(x, y)

    discharge:
        NC-1: similar-reflexive (FORM): similar is reflexive.
              similar-symmetric (FORM): similar is symmetric.
              ax-sim-in-relation-language (FORM): similar is inhabited on Forms.
              Status: FORM.

        NC-2: filtration (axiom in L1): simulation -> congruent -> similar.
              ax-diff-in-relation-language (FORM):
                apply(x) ~~ ground and not (apply(x) == ground).
              The converse of the final implication fails on (apply(ground), ground).
              Strictness of the chain: FORM.
              Status: FORM.

        NC-3: filtration (axiom in L1). In scope. Status: FORM.

        NC-4: ax-diff-in-relation-language (FORM):
              Witness: x := apply(ground), y := ground.
              similar(apply(ground), ground) — FORM.
              not simulation(apply(ground), ground) — FORM.
              Status: FORM.

    graduation-status: FORM
        -- All four necessity constraints discharged.
        -- L2 is fully licensed to proceed.

    permits L2:
        -- (a) Introduce '+' (definitive expansion) grounded in:
        --     the end of one form connecting to the beginning of another.
        --     '+' must stay within the ~~ class of its operands (from NC-1).
        --
        -- (b) Introduce 'additionally' (co-presence) as commutative co-presence
        --     within a single layer. Distinguished from '+' by commutativity.
        --
        -- (c) Introduce the quant family (quant, quanta, quantity, etc.)
        --     grounded in the ordinal structure implied by repeated apply.
        --     Preview of L3: full ordinal arithmetic lives there.
        --
        -- (d) Use filtration freely: any operation that preserves ==
        --     automatically preserves =~ and ~~.

    prohibits L2:
        -- (a) L2 may NOT introduce ordinal_limit or any infinite ordinal.
        --     Those belong to L3. L2 handles finite structures only.
        --
        -- (b) L2 may NOT introduce separate classification machinery.
        --     The self-kernel pattern (present from L0) IS the classification machinery.
        --
        -- (c) L2 may NOT close the FRAME derive 'simulation-pair-exists' from L1.
        --     That closure requires L3 continuation-path machinery.
        --     It remains open at L2.
        --
        -- (d) L2 may NOT assert commutativity for '+'.
        --     '+' is non-commutative. This is a hard invariant from L0 structure.


-- =============================================================================
-- SECTION IV: SEMANTIC CLOSES FOR EXECUTIVE OPAQUES
-- Discharges L0 self-kernel steps 26-32 (FRAME/L1).
-- The 7 executive opaques were declared in L0 Section VIII with syntax only.
-- Their semantic content requires relation-language. That language is now
-- available. Each close below moves an opaque from FRAME to FORM.
-- =============================================================================

close syntax-opaque in relation-language as FORM:
    -- syntax(x) :: HMKeyword means:
    -- x is a form whose structural shape is inspectable at the ~~ level.
    -- syntax is the relation-level anchor: x has a derivation chain reachable
    -- by apply, and that chain is the shape-record for x.
    -- Semantic close: syntax(x) =~ the form's position in the ~~-orbit.
    step 1: For any form x, ax-sim establishes x ~~ ground.
    step 2: x's position in the ~~-orbit (from ax-box-in-relation-language) is
            well-defined — it is the depth of apply-chain required to reach x from ground.
    step 3: syntax(x) closes to: the ~~-orbit depth of x. FORM.
    close: syntax(x) := orbit-depth(x) at similar (~~ level)
    -- Discharges L0 step 26. FORM.

close substance-opaque in relation-language as FORM:
    -- substance(x) :: Prop means:
    -- x carries definite content — its =~-landing is non-empty.
    -- Semantic close: substance(x) closes to x having a defined =~-class.
    -- Two forms share substance iff they are =~-congruent.
    step 1: For any form x, x =~ x (reflexive, same landing, same substance).
    step 2: substance(x) is the =~-equivalence class of x.
    step 3: Closes to: substance(x) := the =~-class containing x. FORM.
    close: substance(x) := congruent-class(x) at congruent (=~ level)
    -- Discharges L0 step 27. FORM.

close semantics-opaque in relation-language as FORM:
    -- semantics(x) :: Prop means:
    -- x is relationally embedded — its position in the == structure is defined.
    -- Semantic close: semantics(x) closes to x having a defined ==-class.
    -- Two forms share semantics iff they are ==-simulation.
    step 1: For any form x, x == x (simulation is reflexive — see below).
    step 2: semantics(x) is the ==-equivalence class of x.
    step 3: Closes to: semantics(x) := simulation-class(x) at simulation (== level). FORM.
    close: semantics(x) := simulation-class(x) at simulation (== level)
    -- Discharges L0 step 28. FORM.

close derives-opaque in relation-language as FORM:
    -- derives(x, y) :: Prop means:
    -- there exists a finite apply-chain from x that reaches a form =~-congruent to y.
    -- The trace from x toward y drops to at most =~ (does not require == preservation).
    -- Semantic close: derives(x, y) := exists finite n such that
    --   apply^n(x) =~ y   (n applications of □ from x reach y's substance-class).
    step 1: For any x, derives(x, apply(x)): one application reaches apply(x).
    step 2: The chain can be extended: if derives(x, z) and derives(z, y) then derives(x, y).
            (Transitivity of derives through =~ landing.)
    step 3: Closes to: derives(x, y) := finite apply-chain from x reaching =~-class of y. FORM.
    close: derives(x, y) := exists-n :: Ordinal, apply^n(x) =~ y
    -- Discharges L0 step 29. FORM.

close discharge-opaque in relation-language as FORM:
    -- discharge(FRAME-name) :: Prop means:
    -- the named FRAME has been closed by a finite derive sequence.
    -- Semantic close: discharge(f) := derives(f-premise, f-conclusion) is FORM
    --   where f-premise and f-conclusion are the open and closed ends of the FRAME.
    step 1: A FRAME names an open obligation.
    step 2: discharge(f) is FORM when the derive chain for f achieves
            a close: line at the appropriate relation level.
    step 3: Closes to: discharge(f) := the derive chain for f is FORM. FORM.
    close: discharge(f) := derive-chain(f).status == FORM
    -- Discharges L0 step 30. FORM.

close definition-opaque in relation-language as FORM:
    -- definition(name, x) :: Prop means:
    -- the name is anchored to form x such that derives(name, x) is FORM.
    -- Semantic close: definition is a derives-claim with a name as source.
    -- definition(name, x) := derives(name, x) where name is a Form-anchor.
    step 1: A name is a Form whose only content is the anchoring act (derives to x).
    step 2: definition(n, x) is FORM when derives(n, x) is FORM.
    step 3: Closes to: definition(n, x) := derives(n, x) is FORM. FORM.
    close: definition(n, x) := derives(n, x).status == FORM
    -- Discharges L0 step 31. FORM.

close form-closure-opaque in relation-language as FORM:
    -- form-closure(x) :: Prop means:
    -- the syntax-substance-semantics triangle completes for x.
    -- In relation language: syntax(x) and substance(x) and semantics(x) are all FORM,
    -- AND the back-arc (semantics -> syntax) holds: semantics(x) derives syntax(x).
    -- This is the cycle condition in the triangle.
    step 1: syntax(x) FORM — orbit-depth defined (above).
    step 2: substance(x) FORM — =~-class defined (above).
    step 3: semantics(x) FORM — ==-class defined (above).
    step 4: The triangle's back-arc: semantics(x) is the ==-embedding of x,
            which determines (derives back to) x's structural shape (syntax).
            The cycle closes: ==-embedding -> orbital shape -> substance -> == embedding.
    step 5: form-closure(x) := all three FORM and the cycle closes. FORM.
    close: form-closure(x) := syntax(x) and substance(x) and semantics(x) and
                              simulation-class(x) derives orbit-depth(x)
    -- Discharges L0 step 32. FORM.


-- =============================================================================
-- SECTION V: DERIVES IS DIRECTIONAL
-- Discharges L0 self-kernel step 41 (FRAME/L1: derives-is-directional).
-- =============================================================================

derive derives-is-directional as FORM:
    -- derives(x, y) does NOT imply derives(y, x) in general.
    -- The apply-chain moves in one direction: from source toward target.
    -- Reversibility would require apply to have an inverse — which it does not
    -- (ax-diff ensures apply(x) ≠ ground, but no axiom gives apply^{-1}).
    --
    -- Witness: x := ground, y := apply(ground).
    --   derives(ground, apply(ground)): trivially — one application.
    --   derives(apply(ground), ground): would require a form z with apply^n(apply(ground)) =~ ground.
    --   By ax-box-in-relation-language: apply(apply(apply(ground))) ~~ apply(ground).
    --   And apply(apply(ground)) ~~ ground.
    --   At =~ level this collapses. At == level: apply(ground) ≠ ground (ax-diff-in-relation-language).
    --   The ~~ return does not constitute a derives in the =~ sense that yields ground.
    --   A full derives(apply(ground), ground) at =~ would need apply^n =~ ground,
    --   and the orbit gives ~~ not =~. So derives(apply(ground), ground) is FRAME (unestablished).
    -- Directional asymmetry is a property of the =~ landing requirement, not just ~~.
    --
    step 1: derives(ground, apply(ground)) — one application. FORM.
    step 2: derives(apply(ground), ground) at =~ level is OPEN at L1
            (would need =~-landing evidence from the orbit, not just ~~ orbit return).
    step 3: The ~~ return (ax-box) does not satisfy the =~ requirement for derives.
    step 4: No axiom in L0 or L1 makes apply invertible at =~ level.
    step 5: Therefore: derives(ground, apply(ground)) is FORM,
                       derives(apply(ground), ground) at =~ is not-FORM at L1.
    step 6: Directional asymmetry is established: derives is not symmetric.
    close: derives-is-directional (FORM)
    -- Discharges L0 step 41. FORM.


-- =============================================================================
-- SECTION VI: TRACE AXIOM
-- Formalizes the trace principle established in term_formation/trace.txt.
-- The trace is the relation level that apply preserves or drops at each step.
-- =============================================================================

axiom trace-levels:
    -- Every application of □ to a form x carries one of three possible traces:
    --   (a) Trace held at ==: apply(x) == x  (simulation preserved — full path)
    --   (b) Trace dropped to =~: apply(x) =~ x  (substance kept, path discarded)
    --   (c) Trace dropped to ~~: apply(x) ~~ x  (origin only — guaranteed by ax-sim)
    -- These are exhaustive and exclusive at each application step.
    -- ~~ is the floor: ax-sim guarantees (c) always holds.
    -- =~ and == are the elevated levels, achievable by construction.
    --
    -- The binary:
    -- When two unary traces both land at =~, they form a congruence pair.
    -- This is the pairing mechanism for D: no product type needed.
    -- pair(a, b) := the =~-congruence class of (trace(a), trace(b)).
    --
    for-all x :: Form:
        (apply(x) ~~ x)                          -- floor: always holds (ax-sim)
        or (apply(x) =~ x and apply(x) ~~ x)     -- elevated to =~
        or (apply(x) == x and apply(x) =~ x)     -- elevated to ==


-- =============================================================================
-- SECTION VII: INDIVIDUALS, SYSTEMS, UNIVERSE
-- Forms whose orbital is L1: they require the relation layer to be stated.
-- =============================================================================

primitive individual : Form
    -- An individual is a Form at a single ordinal depth in the apply-chain.
    -- individual(x) holds when x is exactly one step from its origin form.
    -- The apply-chain position of x uniquely identifies it at the =~ level.
    -- orbital: L1 (requires ~~ and =~ to state "exactly one step").

primitive system : Form
    -- A system is a Form whose members are a ~~ -class: a set of forms all
    -- struct-continuing from a common base form.
    -- system(S) holds when all members of S are ~~ to each other.
    -- orbital: L1 (requires ~~ to define membership criterion).

primitive universe : Form
    -- Universe is the Form that contains all ~~ -classes.
    -- At L1, universe is the closure of the apply-chain under ~~ orbit membership.
    -- Bounded by ax-box: the orbit collapses in two steps, so universe is finite
    -- at ~~ level (all forms partition into {ground-class, apply(ground)-class}).
    -- orbital: L1.

derive individual-is-in-system as FORM:
    -- Every individual is a member of a system.
    step 1: For any individual x, x ~~ ground (ax-sim-in-relation-language).
    step 2: The system whose base is ground contains all forms ~~ to ground.
    step 3: x is ~~ ground, so x is in the ground-system.
    close: individual-is-in-system (FORM)

derive system-is-in-universe as FORM:
    -- Every system is contained in the universe.
    step 1: universe contains all ~~ -classes.
    step 2: Every system is a ~~ -class by definition.
    step 3: Therefore every system is in the universe.
    close: system-is-in-universe (FORM)


-- =============================================================================
-- SECTION VIII: DERIVER AND DERIVATION MATRIX
-- The deriver is a Form whose apply-cycle closes at == (not merely at ~~).
-- D is the derivation matrix: D[x][y] = the trace result from x toward y.
-- Both declared at L1; deriver's cycle-closure is FRAME (construction deferred).
-- =============================================================================

primitive deriver : Form
    -- The deriver is the Form whose function is to traverse the derivation matrix D
    -- and produce closure certificates.
    -- Its defining structural property: its apply-cycle closes at == level,
    -- not merely at ~~ level as ordinary forms do.
    -- Formally: there exists a finite apply-chain from deriver back to deriver
    --           such that every step maintains trace at ==.
    -- This cycle condition is FRAME: the constructive proof is deferred to L3.
    -- What IS established at L1: deriver is a Form. Its ~~ -orbit exists (ax-sim).
    --   Its == -cycle is the target of the L3 derivation.
    -- orbital: L1 (requires relation language to state the cycle condition).

opaque D :: Form -> Form -> Prop
    -- D is the derivation matrix.
    -- D[x][y] holds when there exists a trace-sequence from x to y
    -- maintained at =~ or above (i.e., at least substance is preserved throughout).
    -- D is the structured record of all reachable derives in the system.
    -- Indexed by Form-pairs, where pairing is the =~-congruence of two unary traces
    -- (from the trace-levels axiom above — no product type needed).
    -- D is bounded: the ~~ -orbit is finite (ax-box), so the index space is finite.
    -- orbital: L1 (requires trace-levels and filtration to define the index).

derive D-is-reflexive as FORM:
    -- D[x][x] holds for all x: every form derives to itself (zero trace steps).
    step 1: The zero-step apply-chain from x to x preserves == trivially.
    step 2: == implies =~ (filtration), so =~ -level preservation holds.
    step 3: D[x][x] is FORM for all x.
    close: D-is-reflexive (FORM)

derive D-spans-ground as FORM:
    -- D[ground][y] holds for all y: ground derives every form.
    step 1: By ax-sim-in-relation-language, apply(ground) ~~ ground.
    step 2: By repeated application and ax-box, every form in the ~~ -orbit of ground
            is reachable from ground in at most 2 steps at ~~ level.
    step 3: At =~ level, the reachability is bounded by the orbit structure.
    step 4: D[ground][y] holds for all y in the ~~ -universe. FORM.
    close: D-spans-ground (FORM)

derive deriver-is-in-D as FORM:
    -- D[deriver][deriver] is defined (reflexive entry exists).
    -- The cycle-closure content of that entry is FRAME (L3).
    step 1: D-is-reflexive applies to deriver as a Form.
    step 2: D[deriver][deriver] is FORM (reflexive).
    step 3: The CONTENT of that entry — the full path record at == — is FRAME.
            A reflexive entry establishes the matrix cell. What goes in it is L3.
    close: D[deriver][deriver] entry exists (FORM). Content at == level (FRAME/L3).


-- =============================================================================
-- SECTION IX: L1 SELF-KERNEL
-- Structural census for L1. Mirrors L0 Section IX.
-- =============================================================================

-- L1 self-kernel
-- Purpose: account for every form, axiom, and derive introduced in L1.
-- Count: P_1 (to be determined from steps below).
-- Status: FORM with named FRAMEs.

derive L1-self-kernel as FORM:

    -- ── SECTION I: AXIOMS ─────────────────────────────────────────────────
    step 1:  axiom(filtration)          — simulation -> congruent -> similar. FORM.
    step 2:  axiom(trace-levels)        — three trace outcomes, exhaustive. FORM.

    -- ── SECTION II: DERIVES (relation properties) ─────────────────────────
    step 3:  derive(similar-reflexive)           — x ~~ x. FORM.
    step 4:  derive(similar-symmetric)           — x ~~ y -> y ~~ x. FORM.
    step 5:  derive(ax-sim-in-relation-language) — apply(x) ~~ ground. FORM.
    step 6:  derive(ax-box-in-relation-language) — apply(apply(x)) ~~ x. FORM.
    step 7:  derive(ax-diff-in-relation-language)— apply(x) not-== ground. FORM.
    step 8:  derive(ground-fixed-point)          — apply(ground) ~~ ground, not ==. FORM.
    step 9:  derive(orbit-structure)             — three-element ~~ -class. FORM.
    step 10: derive(simulation-pair-exists)      — ground == ground (trivial). FRAME/L2+.

    -- ── SECTION III: GRADUATION ───────────────────────────────────────────
    step 11: graduation(L1 -> L2)       — all 4 NCs discharged. FORM.

    -- ── SECTION IV: EXECUTIVE OPAQUE CLOSES ──────────────────────────────
    step 12: close(syntax-opaque)       — orbit-depth at ~~. FORM. Discharges L0-26.
    step 13: close(substance-opaque)    — =~-class. FORM. Discharges L0-27.
    step 14: close(semantics-opaque)    — ==-class. FORM. Discharges L0-28.
    step 15: close(derives-opaque)      — finite apply-chain to =~. FORM. Discharges L0-29.
