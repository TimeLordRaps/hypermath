    -- ── SECTION V: DIRECTIONAL DERIVE ────────────────────────────────────
    step 19: derive(derives-is-directional) — derives asymmetric. FORM. Discharges L0-41.

    -- ── SECTION VI: TRACE ────────────────────────────────────────────────
