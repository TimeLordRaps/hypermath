-- L2_operations.hm
-- Layer 2: Operations
-- hypermath | formal-universality
--
-- Layer 1 is the relational substrate. Layer 2 introduces the first operations:
-- sequential connection (+), commutative co-presence (additionally), and
-- derivation-path composition (compose). All operations stay within the ~~ class.
--
-- Layer 2 also introduces the first relation that is not a lift of an L1 relation:
-- abstracted-path (~=). Tier relations are declared on Forms at L1; only L2 lifts
-- them to paths, so there is nothing to abstract over until DerivationPath and
-- quanta exist. Trace LEVELS are L1 content; trace VOLUME is L2 content. ~= is the
-- path quotient that forgets volume, and it is not =~ read backwards --- see
-- Section V.
--
-- Layer boundary: no term from L3 (ordinatics) or above appears in any statement here.
--   L1 terms in scope: all primitives, relations, executive opaques, trace-levels.
--   L2 introduces: +, additionally, DerivationPath, compose,
--                  congruent-path (=~ on paths), abstracted-path (~= on paths).
--
-- Status: FORM (operations defined, graduation criterion discharged).
--   FRAME residuals:
--     simulation-pair-exists — still FRAME. Non-trivial == pair requires
--       both L2 compose AND L3 ordinal continuation. Discharge deferred.
--     deriver ==-cycle content — FRAME (L3, carried forward).
--     congruent-path internals — FRAME (L3). Schema closed at L2 via quantification/trajectory.
--     abstracted-path — NO FRAME residual. ~= drops exactly the quantification
--       coordinate that carries congruent-path's FRAME, so its schema evaluates
--       entirely inside L2. This is the reason abstraction buys compositionality.
--   P_2 = 42. N_2_atomic = 3 (DerivationPath, step, path-ground).
--   G_2 = 4 (graduation NCs for L2 -> L3).
--
-- Sections:
--   I   : Layer permits and prohibits (from L1 graduation)
--   II  : Primitives and opaque predicates
--   III : Axioms for + (definitive expansion)
--   IV  : Axioms for additionally (commutative co-presence)
--   V   : DerivationPath + compose + the two path relations (=~ and ~=)
--   VI  : Derives
--   VII : Graduation criterion L2 -> L3
--   VIII: L2 self-kernel (structural census, 42 steps)
-- =============================================================================


-- =============================================================================
-- SECTION I: LAYER PERMITS AND PROHIBITS
-- Copied from L1 graduation block for traceability.
-- =============================================================================

-- L1 graduation permits L2:
--   (a) '+' : Form -> Form -> Form
--       Non-commutative sequential connection. (a + b) is a Form derived from a by b.
--       Must stay within the ~~ class of its operands (from NC-1 at L1).
--       L2 may NOT assert: a + b == b + a. Commutativity is prohibited at L2.
--   (b) 'additionally' : Form -> Form -> Form
--       Commutative co-presence. additionally(a, b) holds a and b simultaneously.
--       Commutativity holds at the ~~ level.
--   (c) 'compose' : DerivationPath -> DerivationPath -> DerivationPath
--       Sequential composition of two derivation paths.
--   (d) Finite structural operations. L2 handles finite forms only.

-- L1 graduation prohibits L2:
--   (a) ordinal_limit or any infinite ordinal — those belong to L3.
--   (b) Separate classification machinery (self-kernel pattern IS the machinery).
--   (c) Closing 'simulation-pair-exists' from L1 — still FRAME at L2.
--   (d) Asserting commutativity for '+'.


-- =============================================================================
-- SECTION II: PRIMITIVES AND OPAQUE PREDICATES
-- Three new atomic forms at L2.
-- =============================================================================

primitive DerivationPath :: Type
    -- A finite record of apply-steps with their trace-levels.
    -- A DerivationPath is the structural artifact of traversing D[x][y]:
    --   a finite sequence (x_0, r_0), (x_1, r_1), ..., (x_n, r_n)
    --   where each x_i :: Form, r_i is a trace-level (~~/=~/==),
    --   x_{i+1} = apply(x_i), and r_{i+1} >= r_i (non-decreasing trace).
    -- DerivationPath is not Form. It is a first-class index into D.
    -- 'finite': the sequence terminates (no infinite ordinal needed).

primitive step :: Form -> Form -> DerivationPath
    -- step(x)(y): the unit path from x to y in one apply position.
    -- step(x)(y) is only defined when y = apply(x) or y ~~ apply(x).
    -- Produces a singleton DerivationPath of length 1.

primitive path-ground :: DerivationPath
    -- The empty derivation path. Zero steps. Identity for compose.
    -- Analogous to ground :: Form but at the path layer.
    -- compose(p, path-ground) ~~ p at the path level (right identity).
    -- compose(path-ground, p) ~~ p at the path level (left identity).

opaque path-length :: DerivationPath -> Form
    -- The number of steps in a DerivationPath, represented as a Form.
    -- For path-ground: path-length(path-ground) ~~ ground (zero steps).
    -- For step(x)(y): path-length(step(x)(y)) ~~ apply(ground) (one step).
    -- path-length is opaque: the representation of natural numbers as
    --   apply-chains belongs to L3 (ordinal grounding). Here we state
    --   that path-length exists and is a Form; its arithmetic is FRAME/L3.

opaque path-trace :: DerivationPath -> Form
    -- The minimum trace-level (~~/=~/==) across all steps in the path.
    -- path-trace(path-ground) ~~ ground (vacuously, empty path has no floor).
    -- path-trace(step(x)(y)) :: Form representing the trace-level of that step.
    -- Opaque: trace-level comparison arithmetic is L3.


-- =============================================================================
-- SECTION III: AXIOMS FOR + (DEFINITIVE EXPANSION)
-- + is the non-commutative sequential connection of two Forms.
-- =============================================================================

axiom ax-seq: for-all (a b :: Form), exists c :: Form,
    similar(c, a) and similar(c, b)
    -- Every sequential connection (a + b) stays within the ~~ class of BOTH operands.
    -- c is the Form denoted by a + b.
    -- This establishes that + does not escape the ~~ orbit.
    -- It does NOT assert that c = a or c = b; c is a distinct Form in the orbit.

axiom ax-seq-asymm: for-all (a b :: Form),
    not (congruent(a, b)) implies not (congruent(a plus b, b plus a))
    -- If a and b are not already =~-congruent,
    --   then (a + b) and (b + a) are not =~-congruent either.
    -- This is the non-commutativity of + at the =~ level.
    -- Note: similar(a+b, b+a) may still hold (they share ~~ class).
    --       What fails is =~ — the substance is sequencing-sensitive.

axiom ax-seq-identity: for-all (a :: Form),
    congruent(a plus ground, a) and congruent(ground plus a, a)
    -- ground acts as the identity for + at the =~ level.
    -- a + ground =~ a (appending nothing changes nothing substantively).
    -- ground + a =~ a (prepending nothing changes nothing substantively).


-- =============================================================================
-- SECTION IV: AXIOMS FOR ADDITIONALLY (COMMUTATIVE CO-PRESENCE)
-- additionally is the commutative operation holding two Forms simultaneously.
-- =============================================================================

axiom ax-coop: for-all (a b :: Form), exists c :: Form,
    similar(c, a) and similar(c, b)
    -- additionally(a, b) stays within ~~ of both operands.
    -- Structurally the same orbit requirement as ax-seq, but the semantics differ:
    --   + is sequential (order-sensitive in substance).
    --   additionally is simultaneous (order-insensitive in substance).

axiom ax-coop-comm: for-all (a b :: Form),
    congruent(additionally a b, additionally b a)
    -- additionally IS commutative at =~ level.
    -- Substance of (a and b simultaneously) = substance of (b and a simultaneously).
    -- This is the structural difference from +.

axiom ax-coop-identity: for-all (a :: Form),
    congruent(additionally a ground, a) and congruent(additionally ground a, a)
    -- ground acts as the =~-identity for additionally.
    -- additionally(a, ground) =~ a (co-presenting nothing changes nothing).


-- =============================================================================
-- SECTION V: DERIVATIONPATH + COMPOSE
-- Finite path composition. No infinite paths at L2.
-- =============================================================================

axiom ax-compose-assoc: for-all (p q r :: DerivationPath),
    congruent-path(compose p (compose q r), compose (compose p q) r)
    -- compose is associative at the path-congruence level.
    -- congruent-path is the =~-analog for DerivationPath.
    -- This establish compose as a well-formed monoidal operation on paths.
    -- (congruent-path is opaque here; semantics FRAME/L3)

axiom ax-compose-identity: for-all (p :: DerivationPath),
    congruent-path(compose p path-ground, p)
    and congruent-path(compose path-ground p, p)
    -- path-ground is the identity for compose.

axiom ax-compose-nonempty: for-all (x y :: Form),
    exists (p :: DerivationPath), not (congruent-path(p, path-ground))
    and (step x y) congruent-path-part-of p
    -- There always exists a non-empty path connecting any form to any other
    --   via the apply chain (guaranteed by ax-box: apply(apply(x)) ~~ x).
    -- This establishes that DerivationPath is inhabited with non-trivial content.

axiom ax-congruent-path-symm: for-all (p q :: DerivationPath),
    congruent-path(p, q) -> congruent-path(q, p)
    -- path congruence holds both ways.

opaque compose :: DerivationPath -> DerivationPath -> DerivationPath
    -- Sequential composition of two DerivationPaths.
    -- compose(p)(q): the path that traverses p then traverses q.
    -- Domain: DerivationPath × DerivationPath. Codomain: DerivationPath.
    -- Governed by ax-compose-assoc, ax-compose-identity.
    -- The internals (step enumeration, trace-level threading) are FRAME/L3.

opaque congruent-path :: DerivationPath -> DerivationPath -> Prop
    -- The =~-analog for DerivationPath.
    -- Two paths are congruent-path when they have the same substance:
    --   same start, same end, same minimum trace-level — regardless of intermediate steps.

close path-trace in trajectory-language as FORM:
    -- path-trace(p) is the minimum trace-level across the steps of p. It was
    -- declared opaque at Section II on the ground that "trace-level comparison
    -- arithmetic is L3". This close records that no arithmetic is required:
    -- the minimum is a LOOKUP on the DerivationPath record, not a computation.
    --
    -- Machinery used — all of it already earned:
    --   ax-trace-levels (L1) — every step carries exactly one of ~~, =~, ==,
    --     "exhaustive and exclusive at each application step", floor ~~.
    --   ax-filtration (L1)   — == -> =~ -> ~~. The three levels are a CHAIN,
    --     so "minimum" is well defined on them without an order being built here.
    --   DerivationPath (Section II) — a path is a finite record
    --     (x_0,r_0),...,(x_n,r_n) with r_{i+1} >= r_i. NON-DECREASING.
    --
    -- Formal close:
    --   path-trace((x_0,r_0),...,(x_n,r_n)) := r_0          for n >= 0
    --   path-trace(path-ground)             := ground       (empty path, no floor)
    --
    step 1: the three trace levels are exhaustive, exclusive and totally ordered
            by ax-filtration. A minimum over a three-element chain exists and is
            unique for any non-empty selection. FORM.
    step 2: the DerivationPath primitive requires r_{i+1} >= r_i, so the sequence
            of levels along a path is non-decreasing and its minimum is the level
            of its FIRST step. This is the same invariant, and the same reading of
            it, that derive compose-is-a-congruence-for-abstracted-path already
            uses at its step 2 — where it is relied upon as established. FORM.
    step 3: therefore path-trace selects r_0 off the record. Selection is not
            arithmetic: no level is added, compared pairwise, or evaluated. The
            FRAME recorded at Section II against "trace-level comparison
            arithmetic" is against an operation this close does not perform.
            FORM, no residual.
    step 4: the empty case is the declaration's own anchor — path-trace(path-ground)
            ~~ ground, vacuously, since an empty path has no floor to select.
            ax-compose-identity gives the composite case. FORM.
    close: path-trace(p) := r_0 of the DerivationPath record (ground if empty)
    -- Discharges L2 step 5 (opaque(path-trace), FRAME/L3). FORM, no residual.
    --
    -- What this close costs, stated because it is not nothing: it fixes
    -- path-trace as FIRST-step selection rather than as a minimum computed over
    -- the whole path. Those coincide only under the non-decreasing invariant.
    -- A later layer that admitted non-monotone paths would have to reopen this,
    -- and the reopening would be of the close, not of the declaration.

close path-length in quantification-language as FORM:
    -- path-length(p) is the step count of p, carried as a Form. Section II
    -- deferred it on the ground that "the representation of natural numbers as
    -- apply-chains belongs to L3". This close separates the two things that
    -- deferral ran together: the ENCODING, which is L2, and the ARITHMETIC of
    -- the encoding, which is L3 and is discharged there.
    --
    -- Machinery used:
    --   DerivationPath (Section II) — a FINITE record. Its step count exists and
    --     is determinate before any encoding is chosen.
    --   ground, apply (L0) — the apply-chain from ground is the encoding.
    --   similar (~~) (L1) — comparison of two encoded counts. Comparison only.
    --
    -- Formal close:
    --   path-length((x_0,r_0),...,(x_n,r_n)) := apply^{n+1}(ground)
    --   path-length(path-ground)             := ground
    -- which is exactly the two anchors the declaration already states:
    --   path-length(path-ground) ~~ ground              (zero steps)
    --   path-length(step(x)(y))  ~~ apply(ground)       (one step)
    -- generalised from n = 0, 1 to arbitrary finite n. Nothing else is added.
    --
    step 1: the record is finite by the primitive, so n is determinate at L2
            without ordinal machinery. The count is read, not computed. FORM.
    step 2: apply^n(ground) is available from L0 — apply is the sole operation and
            ground the sole irreducible. The encoding is therefore statable here,
            and the declaration's own two anchors are its n = 0 and n = 1 cases.
            FORM.
    step 3: what is NOT closed here is arithmetic ON the encoding — that
            apply^n(ground) +_ord apply^m(ground) is apply^{n+m}(ground). That is
            the standing L2 FRAME "path-length arithmetic requires L3 ordinal
            grounding", and it is what derive composition-length-additive needs.
            This close does not reach it and does not claim it. Whether a layer
            above pays it is that layer's statement to make, not this one's.
    step 4: the split is the same one close(abstracted-path) makes against
            close(congruent-path), one level down: the floor coordinate closes
            with no residual and the counting coordinate closes as a schema with
            its arithmetic deferred. path-trace is to path-length as
            abstracted-path is to congruent-path. The abstraction seam runs
            through the opaque predicates, not only through the relations built
            on them. FORM.
    close: path-length(p) := apply^{n+1}(ground) for an n+1-step record, ground for empty
           (schema FORM at L2; arithmetic of the encoding FRAME/L3, discharged at L3)
    open-frame: "path-length arithmetic requires L3 ordinal grounding"
    -- Discharges L2 step 4 (opaque(path-length), FRAME/L3) at schema level. FORM.
    -- The named residual is the one already recorded against
    -- composition-length-additive and already paid at L3:284. It is restated here
    -- rather than dropped, because this close is what makes it a residual OF a
    -- close rather than of a bare opaque.

close congruent-path in quantification-language as FORM:
    -- Two DerivationPaths p and q are congruent-path when the four-tuple
    -- (start-Form, end-Form, path-trace, quantification-result) is identical.
    -- This is the =~-analog for paths: same substance regardless of intermediate steps.
    --
    -- Machinery used (all L2-available):
    --   path-trace(p)       :: DerivationPath -> Form — minimum trace-level across all steps.
    --   quantification(p)   :: DerivationPath -> Form — total quanta-count of path p.
    --     (quanta = the minimal trace-level-change unit; quanta.txt term_formation)
    --     quantification(path-ground)           = ground  (zero quanta)
    --     quantification(step(x)(y)) at ==       = ground  (trace preserved, no quanta spent)
    --     quantification(step(x)(y)) at ~~       = apply(ground) (one quanta spent)
    --   minimum-quanta trajectory (trajectory.txt §7): the path achieving a trace-level target
    --     with the fewest quanta. congruent-path equivalence classes ARE trajectory-classes:
    --     all paths with the same (start, end, trace-floor, quanta-count) are the same trajectory.
    --
    -- Formal schema:
    --   congruent-path(p, q) :=
    --     similar(start(p), start(q))                   -- (1) same start-Form at ~~
    --     and similar(end(p), end(q))                   -- (2) same end-Form at ~~
    --     and similar(path-trace(p), path-trace(q))     -- (3) same trace-floor
    --     and similar(quantification(p), quantification(q)) -- (4) same quanta-count
    --
    -- Why this closes the substance:
    --   The substance of a path is what it achieves (endpoint, trace-floor, cost).
    --   Two paths with the same four-tuple achieve identical substance regardless of
    --   which intermediate Forms were visited. This matches =~: substance coincides,
    --   path discarded.
    --
    -- FORM status: the schema is fully stateable using L2 opaques and L1 relations.
    --   Arithmetic evaluation of quantification(p) for paths of length > 1 requires
    --   L3 ordinal arithmetic (apply-chain encoding of natural numbers). FRAME/L3.
    step 1: path-trace is opaque at L2 — defined and usable, arithmetic FRAME/L3.
    step 2: quantification is the quanta-counting act — stateable at L2 via quanta.txt.
            quantification(path-ground) = ground (zero quanta) — concrete at L2.
            quantification(step(x)(y)) depends on trace-level of the step — stateable at L2.
    step 3: The four-tuple (start, end, path-trace, quantification) is the substance schema.
            Stated using only similar (~~), path-trace, and quantification — all L2.
    step 4: This schema makes congruent-path well-defined at the schema level.
            The reflexivity of congruent-path follows: any path is congruent-path to itself.
            (same start, same end, same path-trace, same quantification by identity)
    close: =~ (schema FORM at L2; evaluation of quantification for length > 1 FRAME/L3)
    open-frame: "quantification of non-trivial path lengths needs L3 ordinal arithmetic"


relation abstracted-path :: DerivationPath -> DerivationPath -> Prop    -- (~=)
    -- ~= : abstracted from. The tangent path around congruence by which grounded
    --   substance reforms into a new semantics.
    --
    -- ~= IS NOT =~. The two symbol pairs are different relations and the ordering
    --   of the glyphs is the distinction, not a typographic accident:
    --     =~  congruent from   — trace volume carried.
    --     ~=  abstracted from  — trace volume forgotten.
    --   Reading them as one symbol collapses the L2 path quotient into itself and
    --   silently discards the only relation on this layer that closes without a FRAME.
    --
    -- Placement. The filtration chain (== -> =~ -> ~~, L1 Section I) is declared on
    --   Forms. ~= is declared on DerivationPath and has no L1 counterpart: it sits
    --   OFF the chain, a tangent from syntax rejoining semantics around substance,
    --   not a fourth link in it. There is nothing to abstract over until paths and
    --   quanta exist, which is why L2 is the first layer that can state it.
    --
    -- Content. congruent-path agrees on the four-tuple
    --     (start-Form, end-Form, path-trace, quantification).
    --   abstracted-path is that schema with the quantification coordinate dropped:
    --     (start-Form, end-Form, path-trace).
    --   Endpoints and trace-floor pinned; cost forgotten.
    --
    -- Properties: Reflexive (from similar-reflexive, L1). Symmetric (from the
    --   symmetry of ~~, L0). Implied by congruent-path; does NOT imply it.
    --   Strictly weaker — see abstracted-path-is-strictly-weaker, Section VI.
    --   Transitivity is inherited from ~~ on the three coordinates and is therefore
    --   conditional, exactly as it is for congruent-path. Abstraction does not
    --   introduce that limit and does not remove it.
    --
    -- abstracted-path is declared, not opaque. Unlike congruent-path it carries no
    --   FRAME residual; see close(abstracted-path) immediately below.

close abstracted-path in trajectory-language as FORM:
    -- Two DerivationPaths p and q are abstracted-path when the three-tuple
    -- (start-Form, end-Form, path-trace) is identical. Quantification is forgotten.
    --
    -- Machinery used — strictly less than congruent-path requires:
    --   path-trace(p) :: DerivationPath -> Form — minimum trace-level across all steps.
    --   similar (~~)  :: the L1 relation. Comparison only, no arithmetic.
    --   quantification is NOT used. That absence is the content of this close.
    --
    -- Formal schema:
    --   abstracted-path(p, q) :=
    --     similar(start(p), start(q))                   -- (1) same start-Form at ~~
    --     and similar(end(p), end(q))                   -- (2) same end-Form at ~~
    --     and similar(path-trace(p), path-trace(q))     -- (3) same trace-floor
    --   Clause (4) of congruent-path,
    --     similar(quantification(p), quantification(q)),
    --   is deliberately absent. Dropping it is the abstraction.
    --
    -- Why this closes harder than congruent-path closes:
    --   congruent-path is FORM as a schema, but clause (4) requires the arithmetic
    --   evaluation of quantification(p) for paths of length > 1, which is FRAME/L3.
    --   abstracted-path drops exactly that clause. Clauses (1)-(3) need only the
    --   DerivationPath record, path-trace as a Form, and ~~ as a comparison.
    --   No clause of abstracted-path appeals to arithmetic of any kind.
    --   Therefore: congruent-path on paths is FORM-schema with a FRAME internal;
    --   abstracted-path is FORM with no FRAME internal. ~= is the part of the path
    --   quotient that stays inside L2.
    --
    step 1: clauses (1) and (2) read start and end off the DerivationPath record
            (Section II) and compare them by similar (~~), an L1 relation. FORM.
    step 2: clause (3) uses path-trace, opaque at L2. The schema compares two
            path-trace Forms by ~~; it does not evaluate trace-level arithmetic.
            The L3 FRAME recorded against path-trace is about its arithmetic, not
            about comparing two of its values. FORM.
    step 3: no clause mentions quantification, so the open-frame recorded against
            close(congruent-path) does not transfer to this close. FORM, no residual.
    step 4: reflexivity follows from similar-reflexive (L1) on each of the three
            coordinates; symmetry follows from the symmetry of ~~ (L0). Transitivity
            is conditional on ~~ chaining across the three coordinates and is not
            claimed here — the same conditionality congruent-path carries.
    close: ~= (schema FORM at L2; no FRAME residual)
    -- Note on the Lean mechanization. lean4/Hypermath/QuadrilateralFiltration.lean
    -- states AbstractedFrom by IDENTITY of the endpoints rather than by ~~, and its
    -- trace-floor coordinate degenerates because every DStep already carries a
    -- congruence premise. The Lean relation is therefore a strict equivalence and a
    -- REFINEMENT of this schema, not a transcription of it. The two artifacts differ
    -- here on purpose; this file is the design and the Lean is what the kernel accepts.


-- =============================================================================
-- SECTION VI: DERIVES
-- Consequences derivable purely within L2's operation vocabulary.
-- =============================================================================

derive plus-stays-similar as FORM:
    -- From ax-seq and similar-reflexive (L1):
    -- For any a b, (a + b) ~~ a and (a + b) ~~ b.
    -- Proof: ax-seq gives c similar to a and b. c is the denotation of (a+b).
    --   similar(a+b, a): by ax-seq, c similar a, and c = a+b by construction.
    --   similar(a+b, b): by ax-seq, c similar b.
    -- close: ~~ (derivable from ax-seq + similar-reflexive from L1)

derive additionally-stays-similar as FORM:
    -- From ax-coop and similar-reflexive (L1):
    -- For any a b, additionally(a,b) ~~ a and additionally(a,b) ~~ b.
    -- Proof: same structure as plus-stays-similar with ax-coop.
    -- close: ~~ (derivable from ax-coop + similar-reflexive from L1)

derive plus-and-additionally-are-distinct as FORM:
    -- + and additionally are distinct operations.
    -- Proof: ax-seq-asymm gives a b where (a+b) not =~ (b+a).
    --        ax-coop-comm gives additionally(a,b) =~ additionally(b,a) for ALL a b.
    --        These two behaviors cannot be the same operation.
    -- close: =~ (derivable from ax-seq-asymm and ax-coop-comm by contraction)

derive path-ground-is-identity as FORM:
    -- path-ground is the two-sided identity for compose.
    -- Proof: ax-compose-identity directly.
    -- close: =~ (derivable from ax-compose-identity)

derive reflexion as FORM:
    -- reflexion(x) := D[x][x] — the self-read of any form x in the D matrix.
    -- D-is-reflexive (L1): D[x][x] is FORM for all x. The zero-step path at x.
    -- path-ground-is-identity (L2): compose(path-ground, p) =~ p.
    -- Therefore: compose(D[x][x], p) =~ p for any path p starting at x.
    --
    -- reflexion is the conjunction: D-is-reflexive + path-ground-is-identity.
    -- The self-read entry exists (L1) and composes as identity (L2).
    -- No new primitive. No new axiom. Two prior FORM derives composed.
    --
    step 1: D-is-reflexive (L1): D[x][x] = path-ground instantiated at x.
            The zero-step path from x to x. Trace level: == (trivially). FORM.
    step 2: D[x][x] =~ path-ground at position x.
            Both are zero-step paths at x. Same continuation capacity. FORM.
    step 3: compose(D[x][x], p) =~ compose(path-ground, p) =~ p
            for any path p starting at x.
            First =~: step 2 (D[x][x] =~ path-ground).
            Second =~: path-ground-is-identity (L2). FORM.
    step 4: ax-seq-identity (L2): ground + x =~ x.
            Therefore D[ground + x][x] =~ D[x][x] (substituting =~-congruent
            indices in D, which is indexed at =~ by trace-levels L1).
            The +-identity route is a specific access mechanism within L2;
            the substance is steps 1-3. FORM.
    close: reflexion (FORM)
    -- reflexion(x) = the self-read of x in D: zero-cost, identity under compose.
    -- Derived from: D-is-reflexive (L1), path-ground-is-identity (L2),
    -- ax-seq-identity (L2). All L1/L2 content. FORM.

derive orbit-reflexion-quotient as FORM:
    -- The unified width measure for any layer.
    -- Two forms x, y are orbit-reflexion equivalent when their D-columns coincide:
    --   D[x][z] =~ D[y][z] for all z :: Form.
    -- This is equivalent to: x and y reach the same forms (orbit-quotient)
    -- AND the same forms reach x and y (reflexion-quotient).
    -- Forward (orbit): same D-row reachability.
    -- Backward (reflexion): same D-column profile.
    -- These are dual: reachability from generators and D-column =~-class are the
    -- same structural question asked in two directions.
    --
    -- width(L) := |{ [x]_{D-col =~} : x ∈ entities(L) }|
    --
    step 1: D is defined (L1). =~ is defined (L1). Both FORM.
    step 2: "For all z" is bounded: the ~~-orbit is finite (ax-box, L0).
            The universal quantification terminates. FORM.
    step 3: D[x][z] =~ D[y][z] for all z iff x and y have the same derivation
            profile — same reachability, same trace levels, same path structure.
            This is the D-column =~-class of x. FORM.
    step 4: The equivalence relation [x]_{D-col =~} partitions entities(L)
            into orbit-reflexion classes. Each class has one canonical representative.
            Layer width = number of classes. FORM.
    step 5: Composition with trickle-down (depth minimization):
            If x is derivable at layer L-k, trickle-down pushes x to L-k.
            At L-k, orbit-reflexion-quotient checks if x is a new class or
            coincides with an existing entity's D-column.
            The composition trickle-down × orbit-reflexion is a fixed point:
            bounded below (L0, width ≥ 1), each step reduces depth × width
            lexicographically. Terminates. FORM.
    close: orbit-reflexion-quotient (FORM)
    -- The single width measure. Orbit and reflexion are not two mechanics —
    -- they are one quotient seen from two directions. Derived from D (L1),
    -- =~ (L1), ax-box finiteness (L0). FORM.

derive finite-path-exists as FORM:
    -- At least one non-trivial DerivationPath exists.
    -- Proof: ax-compose-nonempty guarantees non-empty paths exist.
    --        step(ground)(apply(ground)) is a concrete instance.
    -- close: ~~ (existential derivation from ax-compose-nonempty)

derive composition-length-additive as FRAME:
    -- length(compose(p)(q)) = length(p) + length(q) in some numeric sense.
    -- FRAME: path-length(p) is a Form, but its arithmetic requires
    --        the ordinal-as-apply-positions structure from L3.
    -- close: FRAME — numeric addition of apply-chain lengths needs L3.
    -- open-frame: "path-length arithmetic requires L3 ordinal grounding"


derive abstracted-path-is-reflexive-and-symmetric as FORM:
    -- ~= is reflexive and symmetric on DerivationPath.
    -- Proof: coordinate-wise. Reflexivity: similar-reflexive (L1) gives
    --        similar(a, a) for each of start, end, path-trace.
    --        Symmetry: ~~ is symmetric (L0 relation declaration), and the schema
    --        is a conjunction of ~~-comparisons, so swapping p and q preserves it.
    -- Transitivity is NOT claimed: ~~ is not transitive in general (L0), and the
    --   schema chains through ~~. congruent-path carries the identical limitation,
    --   so this is a property of the path-relation schema, not a cost of abstracting.
    -- close: ~= (derivable from similar-reflexive (L1) and ~~ symmetry (L0))

derive congruent-path-refines-abstracted-path as FORM:
    -- congruent-path(p, q) implies abstracted-path(p, q). The converse fails.
    -- Proof: the abstracted-path schema is clauses (1)-(3) of the congruent-path
    --        schema. A conjunction implies each of its conjuncts, so dropping
    --        clause (4) is immediate.
    -- Direction matters: volume can always be forgotten, never recovered.
    --   =~ on paths is the finer relation; ~= is its quotient by quanta.
    -- close: ~= (derivable by conjunction elimination on close(congruent-path))

derive abstracted-path-is-strictly-weaker as FORM:
    -- The refinement above is strict: there are paths related at ~= and not at =~.
    -- Witness. Let c be any cycle at x, i.e. a DerivationPath with
    --   similar(start(c), x) and similar(end(c), x).
    -- Compare c against compose(c, c):
    --   (1) same start          — start(compose(c,c)) = start(c). Clause (1) holds.
    --   (2) same end            — end(compose(c,c)) = end(c) ~~ x. Clause (2) holds.
    --   (3) same trace-floor    — compose(c,c) traverses exactly the steps of c,
    --                             twice, so the minimum over its steps is the
    --                             minimum over the steps of c. Clause (3) holds.
    --   (4) DIFFERENT quanta    — traversing c twice spends twice the quanta of c.
    --                             Clause (4) fails provided those two quanta-Forms
    --                             are ~~-distinct.
    -- Therefore abstracted-path(c, compose(c,c)) and not congruent-path(c, compose(c,c)).
    --
    -- Conditional, deliberately, and on TWO named conditions — both L3:
    --   (a) c must spend quanta at all. L2 constructs no such cycle: ax-box (L0)
    --       gives apply(apply(x)) ~~ x, a return at ~~, not a quanta-spending cycle
    --       with a pinned floor. The unconditional witness is the deriver ==-cycle,
    --       FRAME/L3, already on this layer's FRAME inventory.
    --   (b) quantification(c) and quantification(compose(c,c)) must be ~~-distinct.
    --       Quantification is Form-valued and clause (4) compares by ~~, the weakest
    --       relation in the filtration. Separating two apply-chain lengths at ~~ is
    --       ax-diff applied to ordinal positions, which is L3 content. Nothing at L2
    --       forbids two different quanta-counts from being ~~-similar.
    -- So the refinement is strict as FORM under (a) and (b), and FRAME/L3 without them.
    --
    -- The Lean proves the unconditional form only because it swaps the Form-valued
    --   quanta for Nat: abstractedNotCongruentAtCycle separates the counts by
    --   Nat.noConfusion, which is literal inequality, not ~~-distinctness. That is the
    --   second place where the mechanization refines this file rather than mirroring
    --   it — see the note on close(abstracted-path) for the first.
    -- close: ~= (FORM under (a) and (b); unconditional form is FRAME/L3)
    -- open-frame: "unconditional ~= strictness needs the deriver ==-cycle and
    --              ~~-separation of quanta-counts, both L3"

derive abstraction-evaluates-inside-L2 as FORM:
    -- ~= is fully evaluable at L2. =~ on paths is not.
    -- This is the operative difference between the two path relations and the
    -- reason the quadrilateral has an off-branch at all.
    --
    step 1: close(congruent-path) is FORM as a schema but records the open-frame
            "quantification of non-trivial path lengths needs L3 ordinal arithmetic".
            To DECIDE congruent-path(p, q) for paths of length > 1 one must evaluate
            quantification, which L2 cannot do. FRAME/L3.
    step 2: close(abstracted-path) records no open-frame. Its three clauses need the
            DerivationPath record, path-trace as a Form, and ~~ as a comparison —
            all L2-available, none arithmetic. FORM.
    step 3: Therefore L2 can decide ~= on paths it cannot decide =~ on. The layer
            has a working path quotient before L3 supplies ordinal arithmetic.
    step 4: The consequence is not cosmetic. Every L2 construction that needs to
            quotient paths — reflexion, orbit-reflexion-quotient, and composition
            below — can be carried at ~= without borrowing from L3. Carried at =~
            they would each inherit the quantification FRAME.
    close: ~= (FORM; the absence of an open-frame on close(abstracted-path) is the proof)
    -- Abstraction is not a weaker congruence that happens to be convenient.
    -- It is the largest part of the path quotient that this layer can actually close.

derive compose-is-a-congruence-for-abstracted-path as FORM:
    -- If abstracted-path(p, p') and abstracted-path(q, q'), and the junctions agree
    -- (end(p) ~~ start(q) and end(p') ~~ start(q')), then
    --   abstracted-path(compose(p, q), compose(p', q')).
    --
    step 1: start(compose(p,q)) = start(p) and end(compose(p,q)) = end(q), by the
            definition of compose (Section V). Clauses (1) and (2) transfer directly
            from the hypotheses on p, p' and q, q'.
    step 2: path-trace(compose(p,q)) = path-trace(p) for non-empty p. The
            DerivationPath primitive (Section II) requires r_{i+1} >= r_i, so the
            trace-level is non-decreasing along a path and its minimum is the level of
            its FIRST step; compose lays the steps of p down first. This uses only the
            non-decreasing invariant already carried by the primitive — not compose's
            step-enumeration or trace-level-threading internals, which Section V marks
            FRAME/L3, and no arithmetic. Clause (3) therefore transfers from the
            hypothesis on p and p'.
            For empty p, ax-compose-identity gives compose(path-ground, q) =~ q and
            the clause transfers from q and q' instead.
    step 3: No fourth clause exists to discharge. The derivation closes here.
    --
    -- Contrast, and this is the whole point of the abstraction filtration:
    --   The same statement for congruent-path needs a fourth clause,
    --     similar(quantification(compose(p,q)), quantification(compose(p',q'))),
    --   and discharging it requires quantification to distribute over compose —
    --   which is composition-length-additive, declared FRAME/L3 in this very section.
    --   So compose is a congruence for ~= at L2, and a congruence for =~ only modulo
    --   an L3 FRAME.
    -- Compositionality of derivation at L2 therefore runs through ~=, not through =~.
    -- close: ~= (FORM; the =~ analogue is FRAME/L3 via composition-length-additive)

derive derives-is-abstraction-tier as FORM:
    -- close(derives-opaque) at L1 reads
    --   derives(x, y) := exists-n :: Ordinal, apply^n(x) =~ y.
    -- The LANDING of each witness is =~. The RELATION is not.
    --
    step 1: each witness n carries four coordinates: start x, end y, landing level =~,
            and the count n, which is the quanta spent reaching y. Congruence tier.
    step 2: the existential discards n. Two witnesses with different n yield the same
            derives(x, y), and nothing in the relation can separate them.
    step 3: discarding the quanta coordinate while pinning start, end and landing
            level is precisely the schema of abstracted-path (Section V, clause (4)
            dropped). derives is that schema applied to apply-chains.
    step 4: therefore derives is an abstraction-tier relation whose MEMBERS are
            congruence-tier. It was labelled =~ because its witnesses land there.
    --
    -- Propagation. discharge-opaque closes to derives(f-premise, f-conclusion) and
    --   definition-opaque closes to derives(name, x). Both are defined as derives, so
    --   both inherit the forgetting: a discharge records that evidence exists, never
    --   how much; a definition records that the definiens is reachable, never at what
    --   cost. Three of the seven L1 executive closes are ~=, not =~.
    --   D (L1 Section IV) is a fourth for the same reason: D[x][y] asserts that a
    --   finite trace exists and retains nothing about which one.
    --
    -- Why this is stated at L2 and not at L1. ~= is an L2 relation. L1 cannot name
    --   the tier of its own derives without a forward reference across the layer
    --   boundary, which this grammar forbids. L1's close is therefore correct as
    --   written and is left untouched; L2 is the first layer that can classify it.
    --   The Lean does the same: the classification sits in L1Relations as
    --   derivesIsAbstractionOfDerivesIn, and the ~= bridge sits in
    --   QuadrilateralFiltration section 4c, which is L2.
    -- close: ~= (FORM; classification of an L1 close by an L2 relation)


-- =============================================================================
-- SECTION VII: GRADUATION CRITERION — L2 -> L3
-- =============================================================================

graduation L2 -> L3:
    -- L3 (Ordinatics) introduces ordinal_limit, finite/infinite ordinals,
    --   ordinal arithmetic, and the deriver ==-cycle constructive proof.
    -- L3 will also provide the machinery to discharge simulation-pair-exists.
    --
    -- New contexts (NCs) from L2 that L3 requires:
    --
    --   NC-1: '+' is a well-defined Form operation staying within ~~.
    --         L3 uses + to build ordinal successor steps.
    --
    --   NC-2: 'additionally' is well-defined and commutative at =~.
    --         L3 uses additionally to hold co-present ordinals (limit stages).
    --
    --   NC-3: DerivationPath and compose are defined, finite, and associative.
    --         L3 uses compose to build the infinite continuation path
    --         needed for simulation-pair-exists.
    --
    --   NC-4: At least one non-trivial DerivationPath exists (finite-path-exists).
    --         L3's ordinal construction requires a base case before inductive step.
    --
    -- Discharges:
    --   NC-1: plus-stays-similar (FORM): a+b ~~ a and a+b ~~ b. Discharged.
    --   NC-2: ax-coop-comm (FORM): additionally commutes at =~. Discharged.
    --   NC-3: path-ground-is-identity (FORM): compose has identity. Discharged.
    --         ax-compose-assoc (FORM): compose is associative. Discharged.
    --   NC-4: finite-path-exists (FORM): non-trivial path exists. Discharged.
    --
    graduation-status: FORM
        -- All 4 NCs discharged at L2. L3 is licensed to proceed.

    permits L3:
        -- (a) ordinal_limit :: Form — the first infinite ordinal position.
        -- (b) ordinal_succ :: Form -> Form — successor in the ordinal sense.
        -- (c) Ordinal arithmetic: +_ord, ×_ord over ordinal Forms.
        -- (d) Closing simulation-pair-exists using compose + ordinal continuation.
        -- (e) Deriver ==-cycle constructive proof (B3 resolution).

    prohibits L3:
        -- (a) L3 may NOT introduce new primitive operations beyond ordinatics.
        -- (b) L3 may NOT assert that + is commutative (that prohibition carries forward).
        -- (c) L3 may NOT introduce separate classification machinery.
        --     The self-kernel pattern (present from L0) IS the classification machinery.


-- =============================================================================
-- SECTION VIII: L2 SELF-KERNEL
-- Structural census of Layer 2. P_2 = 42 steps.
-- N_2_atomic = 3: DerivationPath, step, path-ground.
-- G_2 = 4: graduation NCs.
-- =============================================================================

-- L2 self-kernel: the closed structural census of what this layer establishes.
--
-- Primitives introduced at L2:
-- step 1: primitive(DerivationPath)     — finite apply-step record. FORM.
-- step 2: primitive(step)               — unit path constructor. FORM.
-- step 3: primitive(path-ground)        — empty path, identity. FORM.
--
-- Opaques and relations introduced at L2:
-- step 4: opaque(path-length)           — Form-valued step count.
--                                         Schema: FORM (L2, step 38). Arithmetic: FRAME/L3.
-- step 5: opaque(path-trace)            — minimum trace-level of path.
--                                         FORM (L2, step 37). No FRAME internal.
-- step 6: opaque(compose)               — path composition. FORM (schema). FRAME/L3 (internals).
-- step 7: opaque(congruent-path)        — =~-analog for paths. Schema: FORM (L2). Internals: FRAME/L3.
-- step 8: relation(abstracted-path)     — ~= on paths. Off the L1 filtration chain.
--                                         Schema: FORM (L2). No FRAME internal.
--
-- Axioms for + :
-- step 9: ax-seq                        — + stays within ~~ of both operands. FORM.
-- step 10: ax-seq-asymm                 — + is non-commutative at =~. FORM.
-- step 11: ax-seq-identity              — ground is =~-identity for +. FORM.
--
-- Axioms for additionally :
-- step 12: ax-coop                      — additionally stays within ~~ of both. FORM.
-- step 13: ax-coop-comm                 — additionally commutes at =~. FORM.
-- step 14: ax-coop-identity             — ground is =~-identity for additionally. FORM.
--
-- Axioms for compose :
-- step 15: ax-compose-assoc             — compose is associative at congruent-path. FORM.
-- step 16: ax-compose-identity          — path-ground is compose-identity. FORM.
-- step 17: ax-compose-nonempty          — non-trivial paths exist. FORM.
--
-- Derives:
-- step 18: plus-stays-similar           — a+b ~~ a, a+b ~~ b. FORM.
-- step 19: additionally-stays-similar   — additionally(a,b) ~~ a and b. FORM.
-- step 20: plus-and-additionally-are-distinct — they have distinct =~ behavior. FORM.
-- step 21: path-ground-is-identity      — compose(p, path-ground) =~ p. FORM.
-- step 22: reflexion                    — self-read in D, identity under compose. FORM.
-- step 23: orbit-reflexion-quotient     — unified width measure over D-columns. FORM.
-- step 24: finite-path-exists           — non-trivial DerivationPath exists. FORM.
-- step 25: composition-length-additive  — length adds across compose. FRAME/L3.
--
-- Derives about abstraction (~=):
-- step 26: abstracted-path-is-reflexive-and-symmetric
--                                       — ~= is reflexive and symmetric. FORM.
--                                         Transitivity conditional, as for =~.
-- step 27: congruent-path-refines-abstracted-path
--                                       — =~ on paths implies ~=. FORM.
-- step 28: abstracted-path-is-strictly-weaker
--                                       — the converse fails at any quanta-spending
--                                         cycle whose quanta-counts are ~~-distinct.
--                                         FORM under those two conditions; both are
--                                         L3, so the unconditional form is FRAME/L3.
-- step 29: abstraction-evaluates-inside-L2
--                                       — ~= decides at L2 where =~ cannot. FORM.
-- step 30: compose-is-a-congruence-for-abstracted-path
--                                       — compose respects ~= with no FRAME; the =~
--                                         analogue needs step 25. FORM.
-- step 31: derives-is-abstraction-tier  — L1's derives, discharge, definition and D
--                                         are ~=, not =~. FORM.
--
-- Graduation:
-- step 32: NC-1 discharge               — plus-stays-similar established. FORM.
-- step 33: NC-2 discharge               — additionally commutativity established. FORM.
-- step 34: NC-3 discharge               — compose identity + associativity. FORM.
-- step 35: NC-4 discharge               — finite-path-exists. FORM.
-- step 36: graduation(L2 -> L3)         — all 4 NCs discharged. FORM.
--
-- FRAME residuals at L2:
-- step 37: close(path-trace)           — first-step selection under the
--                                         non-decreasing invariant. FORM.
--                                         No internals residual: selection is not
--                                         arithmetic.
-- step 38: close(path-length)          — apply-chain encoding of the step count.
--                                         Schema: FORM. Arithmetic of the encoding:
--                                         FRAME/L3, discharged by L3
--                                         path-length-arithmetic.
-- step 39: close(congruent-path)        — schema closed via quantification/trajectory. FORM.
--                                         Internals (eval for length > 1): FRAME/L3.
-- step 40: close(abstracted-path)       — schema closed via trajectory alone. FORM.
--                                         No internals residual: the quantification
--                                         clause is dropped, not deferred.
-- step 41: FRAME inventory              — simulation-pair-exists (L2+L3),
--                                         deriver ==-cycle (L3),
--                                         path-length arithmetic (L3),
--                                         congruent-path internals (L3),
--                                         unconditional ~= strictness (L3, via the
--                                           deriver ==-cycle and ~~-separation of
--                                           quanta-counts).
--
-- Closing clause:
-- step 42: ax-congruent-path-symm      — congruent-path holds both ways. FORM.
--
-- Status: FORM with named FRAMEs.
-- P_2 = 42. N_2_atomic = 3. G_2 = 4.
--   N_2_atomic is unchanged: abstracted-path is declared and closed, not atomic.
--   G_2 is unchanged: ~= adds no new graduation obligation on L3.
