-- ground.hm
-- The ground layer of the hypermath_form system.
-- This file is the ground. It has no imports.
-- Everything in this file is a primitive or a direct derive from □.
-- File boundary == layer boundary. No section headers inside.
-- Status: FORM (self-grounding)

-- Terms introduced in this file:
-- □               -- the ground, the closure act, the fixed point. One entity, three roles.
-- Form            -- form-present-to-its-own-forming. for(m): the ranging-over of finite units.
-- apply           -- □(x): the primitive self-application act.
-- for(m)          -- the etymology of Form: for == the ranging-over act; m == the finite ordinal unit.
-- m               -- the finite ordinal unit. One step. The unit form ranges over.
-- ax-diff         -- generates-structure: self-application produces genuine structure, not collapse.
-- ax-sim          -- stays-in-class: generation never leaves the ground-class.
-- ax-box          -- returns-by-similarity: two applications return to the ~~-class of origin.

primitive ground :: Form
    -- □ -- the ground, the closure act, the fixed point.
    -- One irreducible entity in three structural roles:
    --   as ground: the base from which all forms derive.
    --   as closure act: the operation that closes a derivation.
    --   as fixed point: □(□) ~~ □ (derived below).
    -- First use gloss: □ (read: box) is the self-closing ground --
    -- the one act that is simultaneously the doer, the done, and the doing.

primitive apply :: Form -> Form
    -- □(x) -- the primitive self-application act.
    -- apply IS □ acting on a form.
    -- Domain: all Forms. Codomain: Forms.
    -- There is no other primitive operation. Everything else derives from apply.

-- Form: form-present-to-its-own-forming.
-- Etymology: form == for(m)
--   for -- the ranging-over act.
--          In code: for each m in domain -- the iterating act moving through parts.
--          In language: in the act of; directed toward.
--          The act that enters its contents and ranges through them.
--   m   -- the finite ordinal unit. One step. One member of the sequence.
--          Inverse to ordinal_limit: ordinal_limit is the limit approached by
--          accumulating m's. m is what it is made of, taken finitely one at a time.
-- for(m) -- the ranging-over of finite units.
--          The act that generates structure by moving through its own parts.
--          Form is not a shape from outside. Form is the act of forming.
-- Consequence: Form and □ are the same statement from two positions.
--   □ generates Form. Form is □-generated. Neither is prior.

axiom ax-diff:
    -- generates-structure: self-application produces genuine structure, not trivial collapse.
    -- apply(x) != ground for all x.
    not-simulation(apply(x), ground)

axiom ax-sim:
    -- stays-in-class: generation never leaves the ground-class.
    -- apply(x) ~~ ground for all x.
    similar(apply(x), ground)

axiom ax-box:
    -- returns-by-similarity: two applications return to the ~~-class of origin.
    -- apply(apply(x)) ~~ x for all x.
    similar(apply(apply(x)), x)

derive ground-fixed-point as FORM:
    -- □(□) ~~ □: the ground is its own fixed point.
    step 1: ax-sim with x := ground
            -> similar(apply(ground), ground)
    step 2: ax-box with x := ground
            -> similar(apply(apply(ground)), ground)
    step 3: apply(ground) and apply(apply(ground)) are both
            in the ~~-class of ground. They share continuation capacity.
    close: relation(~~)
    -- ~~ closure is the honest level here.
    -- == closure requires ordinatic arithmetic. FRAME for ==.
